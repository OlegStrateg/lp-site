<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow,noarchive">
<title>Pinterest Downloader installed</title>
<style>
:root{
  --bg:#f7f7f5;
  --text:#111111;
  --muted:#676762;
  --purple:#e60023;
  --purple-hover:#c9001f;
  --red:#e60023;
}
*{box-sizing:border-box}
html,body{
  margin:0;min-height:100%;
  font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
  color:var(--text)
}
body{
  min-height:100vh;
  padding:38px 18px;
  background:var(--bg);
  display:flex;
  flex-direction:column
}
.page{
  width:min(980px,100%);
  margin:auto;
  display:flex;
  flex-direction:column;
  align-items:center;
}

/* HERO — сохраняем утвержденную логику */
.hero{width:min(720px,100%);margin:0 auto 40px;text-align:center}
.success{
  width:48px;height:48px;margin:0 auto 18px;border-radius:12px;
  display:grid;place-items:center;background:var(--red);color:#fff;
  box-shadow:none
}
.success svg{width:27px;height:27px}
h1{
  margin:0;font-size:clamp(34px,5vw,50px);
  line-height:1.02;letter-spacing:-.05em;font-weight:850
}
.lead{margin:13px 0 0;color:var(--muted);font-size:17px;line-height:1.45}
.cta{
  width:min(440px,100%);height:64px;margin:25px auto 0;padding:0 16px 0 18px;
  border:0;border-radius:10px;
  background:var(--purple);color:#fff;
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  font-size:17px;font-weight:850;
  box-shadow:0 10px 24px rgba(230,0,35,.13);
  cursor:pointer;
  position:relative;
  overflow:visible;
  transition:transform .16s ease,background .16s ease,box-shadow .16s ease;
  animation:cta-attention 1.15s 1.05s cubic-bezier(.2,.75,.25,1) 1 both;
}
.cta:hover{
  background:var(--purple-hover);
  transform:translateY(-2px);
  box-shadow:0 14px 28px rgba(230,0,35,.18)
}
.cta:hover .arr{transform:translateX(4px)}
.cta:active{transform:translateY(1px) scale(.992);box-shadow:0 6px 16px rgba(230,0,35,.12)}
.cta-left{display:flex;align-items:center;gap:12px}

@keyframes cta-attention{
  0%,100%{transform:translateY(0) scale(1);box-shadow:0 10px 24px rgba(230,0,35,.13)}
  40%{transform:translateY(-2px) scale(1.012);box-shadow:0 17px 34px rgba(230,0,35,.23)}
  68%{transform:translateY(0) scale(1);box-shadow:0 10px 24px rgba(230,0,35,.13)}
}
.cta-icon{
  width:34px;height:34px;border-radius:9px;
  background:url("data:image/png;base64,") center/cover no-repeat;
  box-shadow:none
}
.cta .arr{
  font-size:25px;line-height:1;
  display:inline-flex;align-items:center;justify-content:center;
  transition:transform .18s ease;
  animation:arrow-cue .72s 1.18s ease-out 2;
}
@keyframes arrow-cue{
  0%,100%{transform:translateX(0)}
  45%{transform:translateX(7px)}
}

.click-cue{
  position:absolute;
  right:48px;
  bottom:-27px;
  width:42px;height:42px;
  pointer-events:none;
  opacity:0;
  z-index:5;
  animation:cursor-guide 2.25s .78s cubic-bezier(.2,.7,.2,1) 1 both;
}
.click-cursor{
  position:absolute;
  width:29px;height:35px;
  right:0;bottom:0;
  filter:drop-shadow(0 3px 3px rgba(0,0,0,.22));
}
.click-ring{
  position:absolute;
  width:18px;height:18px;
  border:2px solid rgba(255,255,255,.92);
  border-radius:50%;
  right:22px;top:-4px;
  opacity:0;
  transform:scale(.35);
  animation:tap-ring 2.25s .78s ease-out 1 both;
}
@keyframes cursor-guide{
  0%{opacity:0;transform:translate(20px,18px)}
  18%{opacity:1}
  52%{opacity:1;transform:translate(0,0)}
  60%{opacity:1;transform:translate(-2px,-2px) scale(.92)}
  68%{opacity:1;transform:translate(0,0) scale(1)}
  86%{opacity:1}
  100%{opacity:0;transform:translate(0,0)}
}
@keyframes tap-ring{
  0%,50%{opacity:0;transform:scale(.35)}
  57%{opacity:.9;transform:scale(.55)}
  72%{opacity:0;transform:scale(1.55)}
  100%{opacity:0;transform:scale(1.55)}
}

@media (prefers-reduced-motion: reduce){
  .cta,.cta .arr,.click-cue,.click-ring{animation:none !important}
  .click-cue{display:none}
}

.micro{margin:10px auto 0;color:#8a8a84;font-size:13px;text-align:center}
.open-panel-status{
  width:min(520px,100%);
  min-height:18px;
  margin:8px auto 0;
  color:#8a1c1c;
  font-size:13px;
  line-height:1.4;
  text-align:center
}
.cta:disabled{cursor:wait}
.cta[aria-busy="true"] .arr{
  animation:loading-dot .8s ease-in-out infinite
}
@keyframes loading-dot{
  0%,100%{opacity:.35;transform:translateX(0)}
  50%{opacity:1;transform:translateX(3px)}
}

/* ONBOARDING */
.onboarding{
  width:min(700px,100%);margin:0 auto;padding:24px 0 28px;
  background:transparent;border-radius:0;
  box-shadow:none
}
.onboarding h2{
  margin:0 0 22px;text-align:center;
  font-size:29px;line-height:1.1;letter-spacing:-.04em;font-weight:850
}
.shot-shell{width:700px;max-width:100%;height:300px;margin:0 auto;overflow:visible}
.shot{
  width:700px;height:300px;margin:0;
  position:relative;overflow:hidden;
  border:1px solid #d4d8de;border-radius:15px;background:#fff;
  border-color:#d5d5d0;
  box-shadow:0 24px 64px rgba(20,20,20,.10)
}

/* Chrome top */
.chrome-top{
  height:82px;background:#dbe8fb;border-bottom:1px solid #cbd9ec
}
.tabline{
  height:35px;padding:0 12px;display:flex;align-items:flex-end;gap:8px
}
.tab{
  width:165px;height:29px;background:#fff;border-radius:9px 9px 0 0;position:relative
}
.tab:after{
  content:"×";position:absolute;right:11px;top:4px;font-size:15px;color:#444
}
.plus{font-size:20px;color:#666;margin-bottom:3px}
.toolbar{
  height:47px;padding:0 12px;display:flex;align-items:center;gap:11px;background:#eef4fb
}
.nav{display:flex;gap:10px;color:#8a8d93;font-size:17px}
.address{
  flex:1;height:30px;background:#fff;border:1px solid #dfe3e8;border-radius:999px
}
.tools{display:flex;align-items:center;gap:10px;position:relative}
.chrome-icon{width:21px;height:21px;display:grid;place-items:center;color:#3f4045}
.chrome-icon svg{width:18px;height:18px}
.square{width:15px;height:15px;border:2px solid #3f4045;border-radius:2px}
.avatar{width:20px;height:20px;border-radius:50%;background:#4a90e2}
.dots{
  width:4px;height:4px;border-radius:50%;background:#38393d;
  box-shadow:0 -7px 0 #38393d,0 7px 0 #38393d
}

/* Шаг 1 привязан к самому puzzle, а не к координатам всей сцены */
.puzzle-zone{position:relative;width:29px;height:29px;display:grid;place-items:center}
.puzzle-target{
  width:29px;height:29px;border-radius:50%;display:grid;place-items:center;
  position:relative;z-index:3
}
.puzzle-target:after{
  content:"";position:absolute;inset:-8px;border:3px solid var(--red);border-radius:50%;
  box-shadow:0 0 0 5px rgba(225,77,66,.09);pointer-events:none
}
.guide-1{
  position:absolute;right:49px;top:-30px;height:64px;width:92px;z-index:6;pointer-events:none
}
.guide-1 .num{
  position:absolute;left:0;top:0;width:62px;height:62px;border-radius:50%;
  display:grid;place-items:center;background:#fff;border:3px solid var(--red);
  box-shadow:0 0 0 5px rgba(225,77,66,.075);
  font-family:Georgia,"Times New Roman",serif;font-size:29px;font-weight:700;color:#45464b
}
.guide-1 .shaft{
  position:absolute;left:56px;top:38px;width:31px;height:3px;background:var(--red);
  transform:rotate(10deg);transform-origin:left center
}
.guide-1 .shaft:after{
  content:"";position:absolute;right:-1px;top:50%;transform:translateY(-50%);
  border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:10px solid var(--red)
}

/* Только нужная область страницы, без лишнего декоративного фона */
.canvas{position:absolute;left:0;right:0;top:82px;bottom:0;background:#fff}

/* Chrome Extensions menu */
.menu-wrap{
  position:absolute;top:12px;right:90px;width:352px;
  overflow:visible
}
.menu{
  width:352px;background:#fff;border:1px solid #deded9;border-radius:12px;
  overflow:visible;box-shadow:0 16px 38px rgba(20,20,20,.14)
}
.menu-head{
  border-radius:13px 13px 0 0;
  height:44px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid #ececf0;font-size:14px;font-weight:700
}
.menu-info{padding:10px 14px 11px;border-bottom:1px solid #ececf0}
.menu-info b{display:block;font-size:12px;margin-bottom:3px}
.menu-info span{display:block;color:#666770;font-size:10.5px;line-height:1.3}
.ext-row{
  height:64px;padding:0 14px;display:flex;align-items:center;gap:11px;
  border-bottom:1px solid #ececf0
}
.product-icon{
  width:34px;height:34px;border-radius:8px;flex:0 0 34px;
  background:url("data:image/png;base64,") center/cover no-repeat
}
.ext-name{flex:1;font-size:13px;font-weight:700}
.pin-zone{position:relative;width:34px;height:34px;display:grid;place-items:center}
.pin-target{
  width:34px;height:34px;display:grid;place-items:center;color:#44454c;position:relative;z-index:3
}
.pin-target svg{width:18px;height:18px}
.pin-target:after{
  content:"";position:absolute;inset:-7px;border:3px solid var(--red);border-radius:50%;
  box-shadow:0 0 0 5px rgba(225,77,66,.09);pointer-events:none
}
.guide-2{
  position:absolute;left:48px;top:-14px;width:84px;height:66px;z-index:8;pointer-events:none
}
.guide-2 .num{
  position:absolute;right:0;top:0;width:62px;height:62px;border-radius:50%;
  display:grid;place-items:center;background:#fff;border:3px solid var(--red);
  box-shadow:0 0 0 5px rgba(225,77,66,.075);
  font-family:Georgia,"Times New Roman",serif;font-size:29px;font-weight:700;color:#45464b
}
.guide-2 .shaft{
  position:absolute;left:0;top:30px;width:26px;height:3px;background:var(--red)
}
.guide-2 .shaft:before{
  content:"";position:absolute;left:-1px;top:50%;transform:translateY(-50%);
  border-top:6px solid transparent;border-bottom:6px solid transparent;border-right:10px solid var(--red)
}
.manage{
  border-radius:0 0 13px 13px;
  height:38px;padding:0 14px;display:flex;align-items:center;gap:8px;
  background:#f7f7f8;color:#4c4d52;font-size:12px
}

@media(max-width:720px){
  body{padding:28px 12px 44px}
  .page{margin:0 auto}
  .lead{font-size:15px}
  .cta{height:62px;font-size:16px}
  .onboarding{padding:22px 12px 18px}
  .onboarding h2{font-size:24px}
  .shot-shell{
    width:336px;
    max-width:100%;
    height:144px;
    overflow:hidden;
    border-radius:15px;
    margin:0 auto;
  }
  .shot{
    width:700px;
    height:300px;
    transform:scale(.48);
    transform-origin:top left;
  }
}
@media(max-width:400px){
  .shot-shell{width:308px;height:132px}
  .shot{transform:scale(.44)}
}
@media(max-width:340px){
  .shot-shell{width:273px;height:117px}
  .shot{transform:scale(.39)}
}
</style>

<script type="text/javascript">
(function(){
  const readCookie = (name) => {
    const prefix = name + '=';
    const part = document.cookie.split('; ').find(x => x.startsWith(prefix));
    return part ? decodeURIComponent(part.slice(prefix.length)) : '';
  };
  const gpc = navigator.globalPrivacyControl === true || navigator.doNotTrack === '1' || window.doNotTrack === '1';
  if (gpc || readCookie('lp_privacy') !== 'analytics:1') return;

  window.ym = window.ym || function(){ (window.ym.a = window.ym.a || []).push(arguments); };
  window.ym.l = 1 * new Date();
  const script = document.createElement('script');
  script.async = true;
  script.src = 'https://mc.yandex.ru/metrika/tag.js?id=111652196';
  script.onload = function(){
    window.ym(111652196, 'init', {
      ssr:true,
      webvisor:false,
      clickmap:false,
      ecommerce:'dataLayer',
      referrer:document.referrer,
      url:location.href,
      accurateTrackBounce:true,
      trackLinks:false
    });
  };
  document.head.appendChild(script);
})();
</script>

</head>
<body>
<main class="page">

<section class="hero">
  <div class="success" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M5.4 12.3 9.6 16.5 18.8 7.2" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <h1 id="i18n-heading">Pinterest Downloader installed</h1>
  <p class="lead" id="i18n-lead">Open the extension — it will appear in Chrome’s side panel</p>

  <button class="cta" type="button" id="final-btn">
    <span class="cta-left">
      <span class="cta-icon"></span>
      <span id="btn-text">Open Pinterest Downloader</span>
    </span>
    <span class="arr">→</span>
    <span class="click-cue" aria-hidden="true">
      <svg class="click-cursor" viewBox="0 0 28 34" fill="none">
        <path d="M4 2.8V26.6L10.5 20.9L15.5 31L20 28.8L15 18.8H24L4 2.8Z"
          fill="white" stroke="#111111" stroke-width="1.6" stroke-linejoin="round"/>
      </svg>
      <span class="click-ring"></span>
    </span>
  </button>

  <p class="micro" id="i18n-micro">Opens in Chrome’s side panel</p>
  <p id="open-panel-status" class="open-panel-status" role="status" aria-live="polite" hidden></p>
</section>

<section class="onboarding">
  <h2 id="i18n-pin-title">Pin Pinterest Downloader now — so you don’t have to find it in Chrome later</h2>

  <div class="shot-shell"><div class="shot">
    <div class="chrome-top">
      <div class="tabline">
        <div class="tab"></div>
        <div class="plus">+</div>
      </div>

      <div class="toolbar">
        <div class="nav"><span>←</span><span>→</span><span>↻</span></div>
        <div class="address"></div>

        <div class="tools">
          <div class="puzzle-zone">
            <div class="puzzle-target chrome-icon">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.5 11H19V7a2 2 0 0 0-2-2h-4V3.5a2.5 2.5 0 0 0-5 0V5H4a2 2 0 0 0-2 2v3.8h1.5a2.7 2.7 0 1 1 0 5.4H2V20a2 2 0 0 0 2 2h3.8v-1.5a2.7 2.7 0 1 1 5.4 0V22H17a2 2 0 0 0 2-2v-4h1.5a2.5 2.5 0 0 0 0-5Z"/>
              </svg>
            </div>
            <div class="guide-1">
              <span class="num">1</span>
              <span class="shaft"></span>
            </div>
          </div>

          <div class="square"></div>
          <div class="avatar"></div>
          <div class="dots"></div>
        </div>
      </div>
    </div>

    <div class="canvas">
      <div class="menu-wrap">
        <div class="menu">
          <div class="menu-head">
            <span id="i18n-extensions-title">Extensions</span>
            <span>×</span>
          </div>

          <div class="menu-info">
            <b id="i18n-no-access">No access needed</b>
            <span id="i18n-no-access-desc">The extension doesn’t need access to data on this page</span>
          </div>

          <div class="ext-row">
            <div class="product-icon"></div>
            <div class="ext-name">Pinterest Downloader</div>

            <div class="pin-zone">
              <div class="pin-target">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16 9V4h1a1 1 0 1 0 0-2H7a1 1 0 1 0 0 2h1v5a3 3 0 0 1-3 3v2h5.97v7l1 1 1-1v-7H19v-2a3 3 0 0 1-3-3Z"/>
                </svg>
              </div>
              <div class="guide-2">
                <span class="shaft"></span>
                <span class="num">2</span>
              </div>
            </div>
          </div>

          <div class="manage">⚙ <span id="i18n-manage">Manage extensions</span></div>
        </div>
      </div>
    </div>
  </div></div>
</section>

</main>

<script>
(function () {
  const translations = {"en":{"pageTitle":"Pinterest Downloader installed","heading":"Pinterest Downloader installed","lead":"Open the extension — it will appear in Chrome’s side panel","openButton":"Open Pinterest Downloader","micro":"Opens in Chrome’s side panel","pinTitle":"Pin Pinterest Downloader now — so you don’t have to find it in Chrome later","extensionsTitle":"Extensions","noAccess":"No access needed","noAccessDesc":"The extension doesn’t need access to data on this page","manage":"Manage extensions","opening":"Opening Pinterest Downloader…","readyMessage":"Pinterest Downloader is ready to use.","openError":"Pinterest Downloader could not be opened. Open the Extensions menu and select Pinterest Downloader."},"ru":{"pageTitle":"Pinterest Downloader установлен","heading":"Pinterest Downloader установлен","lead":"Откройте расширение — оно появится в боковой панели Chrome","openButton":"Открыть Pinterest Downloader","micro":"Откроется в боковой панели Chrome","pinTitle":"Закрепите Pinterest Downloader сейчас — чтобы потом не искать его в Chrome","extensionsTitle":"Расширения","noAccess":"Доступ не требуется","noAccessDesc":"Расширению не нужен доступ к данным на этой странице","manage":"Управление расширениями","opening":"Открываем Pinterest Downloader…","readyMessage":"Pinterest Downloader готов к работе.","openError":"Не удалось открыть Pinterest Downloader. Откройте меню расширений и 