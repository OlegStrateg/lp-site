# Боевой домен layerporter.com привязан 18.07.2026 — индексация ОТКРЫТА.
# Дубль *.pages.dev дедуплицируется каноническими ссылками (все → layerporter.com).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Технические домены Cloudflare Pages не должны конкурировать с layerporter.com в индексе.
# Рекомендованный Cloudflare паттерн: production/preview *.pages.dev → noindex.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex


# Pinterest Downloader landing: реальные демонстрационные фото.
# Разрешение действует только на саму посадочную, welcome-правила ниже не меняются.
/pinterest-downloader/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://images.unsplash.com; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

