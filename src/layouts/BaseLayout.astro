---
import '../styles/global.css';

interface AlternateLink {
  hreflang: string;
  href: string;
}

interface HeaderLabels {
  converters: string;
  extensions: string;
  learn: string;
  mainAria?: string;
  localEngine: string;
  localTitle: string;
}

interface FooterLabels {
  tagline: string;
  about: string;
  extensions: string;
  privacy: string;
  terms: string;
  footerAria?: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  robots?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  homePath?: string;
  extensionsPath?: string;
  learnPath?: string;
  headerLabels?: HeaderLabels;
  footerLabels?: FooterLabels;
  alternates?: AlternateLink[];
}

const defaultHeaderLabels: HeaderLabels = {
  converters: 'Converters',
  extensions: 'Extensions',
  learn: 'Learn',
  mainAria: 'Main',
  localEngine: 'Local engine',
  localTitle: 'All tools run on your device',
};

const defaultFooterLabels: FooterLabels = {
  tagline: 'LayerPorter — free, in-browser file converters. No uploads.',
  about: 'About',
  extensions: 'Extensions',
  privacy: 'Privacy',
  terms: 'Terms',
  footerAria: 'Footer',
};

const {
  title,
  description,
  canonicalPath,
  ogTitle = title,
  ogDescription = description,
  ogImage,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1',
  lang = 'en',
  dir = 'ltr',
  homePath = '/',
  extensionsPath = '/extensions/',
  learnPath = '/#learn',
  headerLabels = defaultHeaderLabels,
  footerLabels = defaultFooterLabels,
  alternates = [],
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://layerporter.com';
const canonicalUrl = `${site}${canonicalPath}`;
const resolvedOgImage = ogImage ?? `${site}/og/png-to-psd.png`;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <meta name="robots" content={robots} />
    <meta name="p:domain_verify" content="272122ef2e4a2ceeacbd8a6bc0b0e71f" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LayerPorter" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={homePath}>LayerPorter</a>
        <div class="site-header-right">
          <nav class="site-nav" aria-label={headerLabels.mainAria ?? 'Main'}>
            <a href={`${homePath}#tools`}>{headerLabels.converters}</a>
            <a href={extensionsPath}>{headerLabels.extensions}</a>
            <a href={learnPath}>{headerLabels.learn}</a>
          </nav>
          <slot name="headerExtra" />
          {headerLabels.localEngine && (
            <span class="local-pill" title={headerLabels.localTitle}>
              <span class="local-pill-dot" aria-hidden="true"></span>
              {headerLabels.localEngine}
            </span>
          )}
        </div>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{footerLabels.tagline}</p>
        <nav class="footer-nav" aria-label={footerLabels.footerAria ?? 'Footer'}>
          <a href="/about/">{footerLabels.about}</a>
          <span aria-hidden="true">·</span>
          <a href={extensionsPath}>{footerLabels.extensions}</a>
          <span aria-hidden="true">·</span>
          <a href="/privacy/">{footerLabels.privacy}</a>
          <span aria-hidden="true">·</span>
          <a href="/terms/">{footerLabels.terms}</a>
        </nav>
      </div>
    </footer>
    <script>
      import { track } from '../lib/analytics';
      track('page_view', { path: window.location.pathname });
    </script>
  </body>
</html>
