---
// Long-form supporting articles (/formats/{slug}/, /guides/{slug}/) — plain
// typography, no tool widget. JSON-LD is deliberately Article ONLY: no
// FAQPage schema here even though these pages have a visible FAQ section.
// Two reasons: (1) a brand-new domain has no search history to make FAQ rich
// results likely anyway, and (2) stacking FAQPage on every article as well as
// every converter page raises exactly the kind of "same schema everywhere"
// pattern Search Console flags as templated markup — better to keep it on
// the converter pages, where the FAQ is the primary reason to visit.
import BaseLayout from './BaseLayout.astro';
import ExtensionCTA from '../components/ExtensionCTA.astro';
import SiteVsExtensionTable from '../components/SiteVsExtensionTable.astro';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// Extension relevance gate (see src/data/extensions.ts): the website-capture
// extensions capture a *live page*, so a CTA for them only belongs on the
// one article that's actually about that job. flat-image-vs-editable-layers
// and what-is-a-psd-file are both general-concept explainers with no live-
// page angle, so they deliberately get nothing here even though they're in
// the same 'guides'/'formats' sections.
const EXTENSION_RELEVANT_SLUGS = new Set(['export-from-ai-builders']);
const showExtensionSell = EXTENSION_RELEVANT_SLUGS.has(d.slug);

// Right rail: the article column is 70ch, the site container is 1152px — on
// desktop the difference was dead space (owner flagged it 19.07). The rail
// fills it with the tools this article is actually about, per slug; every
// href is a real page. Falls under the article on mobile.
const RELATED_TOOLS: Record<string, { href: string; name: string; badge: string }[]> = {
  psd: [
    { href: '/convert/png-to-psd/', name: 'PNG to PSD', badge: 'PNG' },
    { href: '/convert/psd-to-png/', name: 'PSD to PNG', badge: 'PSD' },
    { href: '/convert/psd-to-jpg/', name: 'PSD to JPG', badge: 'PSD' },
  ],
  'flat-image-vs-editable-layers': [
    { href: '/convert/png-to-psd/', name: 'PNG to PSD', badge: 'PNG' },
    { href: '/convert/jpg-to-psd/', name: 'JPG to PSD', badge: 'JPG' },
    { href: '/convert/psd-to-png/', name: 'PSD to PNG', badge: 'PSD' },
  ],
  'export-from-ai-builders': [
    { href: '/convert/png-to-psd/', name: 'PNG to PSD', badge: 'PNG' },
    { href: '/convert/jpg-to-pdf/', name: 'JPG to PDF', badge: 'JPG' },
    { href: '/convert/favicon-generator/', name: 'Favicon Generator', badge: 'ICO' },
  ],
};
const railTools = RELATED_TOOLS[d.slug] ?? [
  { href: '/convert/jpg-to-pdf/', name: 'JPG to PDF', badge: 'JPG' },
  { href: '/convert/pdf-to-jpg/', name: 'PDF to JPG', badge: 'PDF' },
  { href: '/convert/png-to-psd/', name: 'PNG to PSD', badge: 'PNG' },
];

const RELATED_READING: Record<string, { href: string; name: string }[]> = {
  psd: [
    { href: '/guides/flat-image-vs-editable-layers/', name: 'Flat image vs editable layers' },
    { href: '/guides/export-from-ai-builders/', name: 'Export designs from AI builders' },
  ],
  'flat-image-vs-editable-layers': [
    { href: '/formats/psd/', name: 'What is a PSD file?' },
    { href: '/guides/export-from-ai-builders/', name: 'Export designs from AI builders' },
  ],
  'export-from-ai-builders': [
    { href: '/formats/psd/', name: 'What is a PSD file?' },
    { href: '/guides/flat-image-vs-editable-layers/', name: 'Flat image vs editable layers' },
  ],
};
const relatedReading = RELATED_READING[d.slug] ?? [];

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://layerporter.com';
const pagePath = `/${d.section}/${d.slug}/`;
const pageUrl = `${site}${pagePath}`;
const sectionLabel = d.section === 'formats' ? 'Formats' : 'Guides';
// Per-article OG image, generated by scripts/generate-og-image.mjs from the
// same `key` (public/og/{key}.png) — mirrors how ConverterLayout does it.
const ogImageUrl = `${site}/og/${d.key}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#org`,
      name: 'LayerPorter',
      url: `${site}/`,
    },
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: d.h1,
      description: d.description,
      datePublished: '2026-07-16',
      dateModified: '2026-07-16',
      author: { '@id': `${site}/#org` },
      publisher: { '@id': `${site}/#org` },
      mainEntityOfPage: pageUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'LayerPorter', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: sectionLabel, item: `${site}/${d.section}/` },
        { '@type': 'ListItem', position: 3, name: d.h1, item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title={d.title}
  description={d.description}
  canonicalPath={pagePath}
  ogTitle={d.h1}
  ogDescription={d.description}
  ogImage={ogImageUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href={`/${d.section}/`}>{sectionLabel}</a>
  </nav>

  <div class="article-grid">
    <article class="page-prose article-prose">
      <h1>{d.h1}</h1>
      <p class="answer-first">{d.answerFirst}</p>

      <Content />

      {d.faq.length > 0 && (
        <section aria-labelledby="faq-heading">
          <h2 id="faq-heading">{d.faqHeading}</h2>
          {d.faq.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>
      )}

      {showExtensionSell && (
        <>
          <SiteVsExtensionTable />
          <ExtensionCTA surface={`${d.section}/${d.slug}`} />
        </>
      )}
    </article>

    <aside class="article-rail" aria-label="Related tools">
      <div class="rail-card">
        <p class="rail-head">Try it in your browser</p>
        <p class="rail-sub">Free, local — files never leave your device.</p>
        {railTools.map((t) => (
          <a class="rail-tool" href={t.href}>
            <span class="tool-icon" aria-hidden="true">{t.badge}</span>
            <span>{t.name}</span>
          </a>
        ))}
      </div>
      {relatedReading.length > 0 && (
        <div class="rail-card">
          <p class="rail-head">Related reading</p>
          {relatedReading.map((item) => (
            <a class="text-link" href={item.href}>{item.name} →</a>
          ))}
        </div>
      )}
      <div class="rail-card rail-ext">
        <p class="rail-head">Browser extensions</p>
        <p class="rail-sub">Capture a live page as editable layers — coming to the Chrome Web Store.</p>
        <a class="text-link" href="/extensions/">See extensions →</a>
      </div>
    </aside>
  </div>
</BaseLayout>
