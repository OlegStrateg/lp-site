<script>
  import { track } from '../lib/analytics';
  track('page_view', { path: window.location.pathname });
  document.querySelectorAll('a[href]').forEach((link) => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '';
      if (href.startsWith('/extensions') || href.startsWith('/pinterest-downloader')) {
        track('path_card_click', { target: 'home_extension', href });
      } else if (href.startsWith('/convert')) {
        track('path_card_click', { target: 'home_tool', href });
      }
    });
  });
</script>
