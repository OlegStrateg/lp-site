---
import PageLayout from '../../layouts/PageLayout.astro';
import * as product from '../../copy/website-image-optimizer-mcp.md';

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://layerporter.com';
const canonical = `${site}/mcp/website-image-optimizer/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'LayerPorter Website Image Optimizer MCP',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Model Context Protocol server',
  operatingSystem: 'Node.js',
  softwareVersion: '0.1.2',
  softwareRequirements: 'Node.js >=22.12.0',
  downloadUrl: 'https://www.npmjs.com/package/@layerporter/image-optimizer-mcp',
  softwareHelp: `${site}/docs/mcp/website-image-optimizer/`,
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  featureList: [
    'Analyze page images',
    'Optimize and resize images',
    'Generate responsive image variants',
    'Compare before and after image versions',
    'Analyze bounded public URL image sources',
  ],
  url: canonical,
  description: 'Optimize website images with an MCP server for AI agents: analyze page images, compress and resize safely, generate responsive variants, and verify results.',
  isPartOf: {
    '@type': 'WebSite',
    name: 'LayerPorter',
    url: site,
  },
};
---

<PageLayout
  title="Website Image Optimizer MCP for AI Agents | LayerPorter"
  description="Optimize website images with an MCP server for AI agents. Analyze page images, compress and resize safely, generate responsive variants, and verify results."
  canonicalPath="/mcp/website-image-optimizer/"
  ogImage={`${site}/og/home.png`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <product.Content />
</PageLayout>
