  .web-page{height:496px}
  .panel{left:18px;right:18px;top:76px;bottom:18px;width:auto}
  .task-strip{grid-template-columns:1fr}.task-strip div{border-right:0;border-bottom:1px solid var(--line)}.task-strip div:last-child{border-bottom:0}
  .section,.pdf-section,.format-section,.compare{padding:76px 0}
  .section-head{gap:22px}
  .section-copy,.local-copy{padding:30px}
  .web-flow-visual{min-height:430px;padding:22px}
  .site-image{height:260px}
  .convert-flow{grid-template-columns:1fr}.arrow{transform:rotate(90deg);text-align:center}
  .pages{grid-template-columns:repeat(2,1fr)}
  .format-grid{grid-template-columns:1fr}
  .format-card{border-right:0;border-bottom:1px solid var(--line);min-height:auto}
  .format-card:last-child{border-bottom:0}
  .flow-row{grid-template-columns:1fr;gap:9px}
  .faq{padding:72px 0}.faq-grid{gap:32px}.faq h2{font-size:46px}
  .signal{grid-template-columns:1fr 1fr}.signal span{border-bottom:1px solid var(--line)}.signal span:nth-child(2n){border-right:0}
  .final{padding:78px 0 90px}
  .footer-row{flex-direction:column}
  .mobile-install{display:flex}
  body{padding-bottom:74px}
}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
