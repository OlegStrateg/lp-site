.signal{display:grid;grid-template-columns:repeat(5,1fr);border-block:1px solid var(--line);margin-top:34px}
.signal span{padding:13px 8px;text-align:center;border-right:1px solid var(--line);font-size:10px;font-weight:850;color:#5d5763}.signal span:last-child{border-right:0}
footer{padding:28px 0;border-top:1px solid var(--line);font-size:10px;color:#817b86}
.footer-row{display:flex;justify-content:space-between;gap:20px}
.mobile-install{display:none;position:fixed;left:12px;right:12px;bottom:12px;z-index:110;min-height:54px;border-radius:11px;background:var(--violet);color:#fff;align-items:center;justify-content:center;font-weight:900;font-size:14px;box-shadow:0 16px 38px rgba(30,20,50,.22)}
@media(max-width:1060px){
  .hero{grid-template-columns:1fr;min-height:auto;padding-top:62px}
