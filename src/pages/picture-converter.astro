.final{position:relative;overflow:hidden;background:var(--violet);color:#fff;text-align:center;padding:98px 0 104px}
.final:before{content:"";position:absolute;width:460px;height:460px;border-radius:50%;border:1px solid rgba(255,255,255,.17);left:50%;top:50%;transform:translate(-50%,-50%)}
.final>*{position:relative}.final .eyebrow{justify-content:center;color:#fff;opacity:.9}.final .mark{background:#fff;color:var(--violet)}
.final h2{max-width:980px;margin:0 auto;font-size:clamp(60px,7vw,100px);line-height:.88;letter-spacing:-.073em}
.final p{max-width:720px;margin:24px auto 0;font-size:17px;line-height:1.55;opacity:.9}
