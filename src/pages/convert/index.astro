---
import ConvertHubPage from '../../components/ConvertHubPage.astro';
import { CONVERT_HUB_LOCALES, CONVERT_HUB_BY_CODE } from '../../data/convertHubLocales';
import { applyConvertHubEditorialOverrides } from '../../data/convertHubEditorialOverrides';

applyConvertHubEditorialOverrides(CONVERT_HUB_LOCALES);

const locale = CONVERT_HUB_BY_CODE.get('en');
if (!locale) throw new Error('Missing en convert hub locale');
---

<ConvertHubPage locale={locale} />