---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const ALL_ORDER = [
  'jpg-to-pdf','pdf-to-jpg','webp-to-jpg','favicon-generator',
  'psd-to-png','psd-to-jpg','png-to-psd','jpg-to-psd','canva-to-google-slides',
];

const all = await getCollection('converters');
const byKey = new Map(all.map((item) => [item.data.key, item]));
const listed = ALL_ORDER.map((key) => byKey.get(key)).filter(
  (item): item is NonNullable<typeof item> => Boolean(item),
);

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://layerporter.com';
const title = 'Free File Converter — JPG, PDF, WebP & PSD | LayerPorter';
const description = 'Free file converters for JPG, PNG, PDF, WebP and PSD. Convert files in your browser with no uploads, no account and no server processing.';
const preferredImage = `${site}/og/convert.png`;
const pictureConverterStore = 'https://chromewebstore.google.com/detail/picture-converter/oegpbmdpckfdgodnkdnoggedamfflfcl?utm_source=layerporter&utm_medium=website&utm_campaign=convert_hub&utm_content=extension_block';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site}/convert/#collection`,
  url: `${site}/convert/`,
  name: 'Free File Converter',
  description,
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: preferredImage,
    width: 1200,
    height: 630,
  },
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    name: 'LayerPorter',
    url: `${site}/`,
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: listed.length,
    itemListElement: listed.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.data.h1.split('—')[0].trim(),
      url: `${site}/convert/${item.data.key}/`,
    })),
  },
  hasPart: {
    '@type': 'SoftwareApplication',
    name: 'Picture Converter',
    applicationCategory: 'BrowserApplication',
    operatingSystem: 'Chrome',
    url: `${site}/picture-converter/`,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/convert/"
  ogImage={preferredImage}
>
  <link slot="head" rel="stylesheet" href="/convert-hub.css" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <div class="hub">
    <section class="hub-hero" aria-labelledby="convert-h1">
      <div class="hub-hero-copy">
        <div class="hub-eyebrow"><span aria-hidden="true">↔</span> All browser conversion routes</div>
        <h1 id="convert-h1"><span>Free file converters.</span><br />Choose the exact route.</h1>
        <p>
          All LayerPorter web converters in one place: JPG, PNG, PDF, WebP, PSD and ICO.
          Open the exact format pair you need — no account and no server upload queue.
        </p>
        <div class="hub-proof" aria-label="Converter hub facts">
          <span><b>●</b> 8 converters</span>
          <span><b>●</b> 1 compatibility checker</span>
          <span><b>●</b> Local browser processing</span>
        </div>
      </div>

      <div class="hub-route-board" aria-label="All available converters">
        <div class="hub-route-head"><strong>Choose a conversion</strong><span>ALL CURRENT TOOLS</span></div>
        <div class="hub-route-columns">
          <div class="hub-route-column">
            <a class="hub-route" href="/convert/jpg-to-pdf/"><span class="hub-code">JPG</span><i>→</i><span class="hub-code out">PDF</span><span class="hub-route-copy"><b>JPG to PDF</b><small>Combine images into one PDF</small></span><em>↗</em></a>
            <a class="hub-route" href="/convert/pdf-to-jpg/"><span class="hub-code">PDF</span><i>→</i><span class="hub-code out">JPG</span><span class="hub-route-copy"><b>PDF to JPG</b><small>Turn pages into images</small></span><em>↗</em></a>
            <a class="hub-route" href="/convert/webp-to-jpg/"><span class="hub-code">WEBP</span><i>→</i><span class="hub-code out">JPG</span><span class="hub-route-copy"><b>WebP to JPG</b><small>Make WebP widely compatible</small></span><em>↗</em></a>
            <a class="hub-route" href="/convert/favicon-generator/"><span class="hub-code">IMG</span><i>→</i><span class="hub-code out">ICO</span><span class="hub-route-copy"><b>Favicon Generator</b><small>Create ICO and favicon sizes</small></span><em>↗</em></a>
          </div>
          <div class="hub-route-column">
            <a class="hub-route" href="/convert/psd-to-png/"><span class="hub-code">PSD</span><i>→</i><span class="hub-code out">PNG</span><span class="hub-route-copy"><b>PSD to PNG</b><small>Flatten with transparency</small></span><em>↗</em></a>
            <a class="hub-route" href="/convert/psd-to-jpg/"><span class="hub-code">PSD</span><i>→</i><span class="hub-code out">JPG</span><span class="hub-route-copy"><b>PSD to JPG</b><small>Export a standard image</small></span><em>↗</em></a>
            <a class="hub-route" href="/convert/png-to-psd/"><span class="hub-code">PNG</span><i>→</i><span class="hub-code out">PSD</span><span class="hub-route-copy"><b>PNG to PSD</b><small>Move into a PSD workflow</small></span><em>↗</em></a>
            <a class="hub-route" href="/convert/jpg-to-psd/"><span class="hub-code">JPG</span><i>→</i><span class="hub-code out">PSD</span><span class="hub-route-copy"><b>JPG to PSD</b><small>Move into a PSD workflow</small></span><em>↗</em></a>
          </div>
        </div>
        <div class="hub-route-foot"><strong>● Files stay on this device</strong><a href="#checker">Canva → Slides checker ↓</a></div>
      </div>
    </section>

    <section class="hub-section" id="popular" aria-labelledby="popular-heading">
      <div class="hub-section-label">01 · Popular converters</div>
      <div class="hub-section-head">
        <h2 id="popular-heading">The main conversion jobs, shown the way they actually work.</h2>
        <p>Real product imagery where it explains the task. Purpose-built format graphics everywhere else.</p>
      </div>

      <div class="hub-popular-grid">
        <a class="hub-tool-card" href="/convert/jpg-to-pdf/">
          <picture class="hub-tool-image">
            <source srcset="/images/picture-converter/images-to-pdf-example-320.webp 320w, /images/picture-converter/images-to-pdf-example-640.webp 640w, /images/picture-converter/images-to-pdf-example-960.webp 960w" sizes="(max-width:760px) 100vw, 48vw" />
            <img src="/images/picture-converter/images-to-pdf-example-640.webp" width="640" height="427" alt="Images ready to combine into one PDF" loading="lazy" />
          </picture>
          <div class="hub-tool-body"><div class="hub-pair"><span>JPG</span><i>→</i><span>PDF</span></div><h3>JPG to PDF</h3><p>Combine JPG or PNG images into one ordered PDF. Each image becomes a page.</p><b class="hub-open">Open converter <span>↗</span></b></div>
        </a>

        <a class="hub-tool-card" href="/convert/pdf-to-jpg/">
          <div class="hub-pdf-visual" aria-hidden="true">
            <div class="hub-pdf-sheet"><div></div><i></i><i class="medium"></i><i class="short"></i></div>
            <span class="hub-big-arrow">→</span>
            <div class="hub-jpg-stack"><i></i><i></i><i><b>JPG</b></i></div>
          </div>
          <div class="hub-tool-body"><div class="hub-pair"><span>PDF</span><i>→</i><span>JPG</span></div><h3>PDF to JPG</h3><p>Render every PDF page into its own JPG image file.</p><b class="hub-open">Open converter <span>↗</span></b></div>
        </a>

        <a class="hub-tool-card" href="/convert/webp-to-jpg/">
          <picture class="hub-tool-image">
            <source srcset="/images/picture-converter/webp-to-jpg-example-320.webp 320w, /images/picture-converter/webp-to-jpg-example-640.webp 640w, /images/picture-converter/webp-to-jpg-example-960.webp 960w" sizes="(max-width:760px) 100vw, 48vw" />
            <img src="/images/picture-converter/webp-to-jpg-example-640.webp" width="640" height="427" alt="WebP image ready to convert to JPG" loading="lazy" />
          </picture>
          <div class="hub-tool-body"><div class="hub-pair"><span>WEBP</span><i>→</i><span>JPG</span></div><h3>WebP to JPG</h3><p>Convert a WebP image into a JPG that works almost everywhere.</p><b class="hub-open">Open converter <span>↗</span></b></div>
        </a>

        <a class="hub-tool-card" href="/convert/favicon-generator/">
          <div class="hub-favicon-visual" aria-hidden="true">
            <div class="hub-favicon-main">LP</div>
            <div class="hub-icon-sizes"><span><i></i><b>16</b></span><span><i></i><b>32</b></span><span><i></i><b>48</b></span><span><i></i><b>180</b></span><span><i></i><b>256</b></span><span><i></i><b>512</b></span></div>
          </div>
          <div class="hub-tool-body"><div class="hub-pair"><span>IMG</span><i>→</i><span>ICO</span></div><h3>Favicon Generator</h3><p>Create a favicon set and ICO file from one source image.</p><b class="hub-open">Open tool <span>↗</span></b></div>
        </a>
      </div>
    </section>

    <section class="hub-section hub-section-alt" id="design" aria-labelledby="design-heading">
      <div class="hub-section-label">02 · Image & design converters</div>
      <div class="hub-section-head">
        <h2 id="design-heading">Four PSD routes. One consistent visual system.</h2>
        <p>File layers and output states explain these conversions more clearly than unrelated photography.</p>
      </div>

      <div class="hub-design-grid">
        <a class="hub-design-card" href="/convert/psd-to-png/"><div><div class="hub-pair"><span>PSD</span><i>→</i><span>PNG</span></div><h3>PSD to PNG</h3><p>Flatten a PSD into a PNG while keeping transparent areas transparent.</p><b>Open converter ↗</b></div><div class="hub-design-art"><div class="hub-art-flow"><span class="hub-layer-stack"><i></i><i></i><i></i></span><em>→</em><span class="hub-output png">PNG</span></div></div></a>
        <a class="hub-design-card" href="/convert/psd-to-jpg/"><div><div class="hub-pair"><span>PSD</span><i>→</i><span>JPG</span></div><h3>PSD to JPG</h3><p>Flatten a PSD into a standard JPG image for easy sharing and compatibility.</p><b>Open converter ↗</b></div><div class="hub-design-art"><div class="hub-art-flow"><span class="hub-layer-stack"><i></i><i></i><i></i></span><em>→</em><span class="hub-output jpg">JPG</span></div></div></a>
        <a class="hub-design-card" href="/convert/png-to-psd/"><div><div class="hub-pair"><span>PNG</span><i>→</i><span>PSD</span></div><h3>PNG to PSD</h3><p>Put a PNG into a PSD document so it can continue through a PSD-based workflow.</p><b>Open converter ↗</b></div><div class="hub-design-art"><div class="hub-art-flow"><span class="hub-output png">PNG</span><em>→</em><span class="hub-output psd">PSD</span></div></div></a>
        <a class="hub-design-card" href="/convert/jpg-to-psd/"><div><div class="hub-pair"><span>JPG</span><i>→</i><span>PSD</span></div><h3>JPG to PSD</h3><p>Move a JPG into a PSD document for the next stage of the editing workflow.</p><b>Open converter ↗</b></div><div class="hub-design-art"><div class="hub-art-flow"><span class="hub-output jpg">JPG</span><em>→</em><span class="hub-output psd">PSD</span></div></div></a>
      </div>

      <a class="hub-checker" id="checker" href="/convert/canva-to-google-slides/">
        <div class="hub-checker-copy"><span>Compatibility checker</span><h3>Canva → Google Slides</h3><p>Inspect a Canva PPTX locally before import and surface fonts, grouped objects or effects that may behave differently in Google Slides.</p><b>Open checker <i>↗</i></b></div>
        <div class="hub-checker-visual" aria-hidden="true"><div class="hub-checker-window"><div class="hub-checker-top"><b>presentation.pptx</b><span>18 slides · local analysis</span></div><div class="hub-checker-content"><div class="hub-slide-list"><i></i><i></i><i></i></div><div class="hub-results"><div><span>Aa</span><p><b>Font compatibility</b><small>2 fonts may be substituted</small></p><em class="warn">CHECK</em></div><div><span>▣</span><p><b>Grouped objects</b><small>Compatible with Slides</small></p><em>OK</em></div><div><span>✦</span><p><b>Effects</b><small>1 effect may render differently</small></p><em class="warn">CHECK</em></div></div></div></div></div>
      </a>
    </section>

    <section class="hub-extension" id="picture-converter" aria-labelledby="picture-converter-heading">
      <div class="hub-extension-visual"><img src="/images/picture-converter/picture-converter-chrome-960.webp" srcset="/images/picture-converter/picture-converter-chrome-320.webp 320w, /images/picture-converter/picture-converter-chrome-640.webp 640w, /images/picture-converter/picture-converter-chrome-960.webp 960w" sizes="(max-width:800px) 100vw, 58vw" width="960" height="640" alt="Picture Converter Chrome extension interface" loading="lazy" /></div>
      <div class="hub-extension-copy"><div class="hub-extension-brand"><img src="/picture-converter/welcome/picture-converter-icon.png" width="46" height="46" alt="Picture Converter icon" loading="lazy" /><div><strong>Picture Converter</strong><small>Chrome extension</small></div></div><h2 id="picture-converter-heading">Need more image formats or conversion directly from a website?</h2><p>Picture Converter adds WebP, HEIC, AVIF and other image workflows directly to Chrome, including images you are already viewing on a page.</p><div class="hub-extension-actions"><a class="store" href={pictureConverterStore}>Add to Chrome ↗</a><a class="details" href="/picture-converter/">See Picture Converter</a></div></div>
    </section>

    <section class="hub-section" id="privacy" aria-labelledby="trust-heading">
      <div class="hub-section-label">04 · Why LayerPorter converters</div>
      <h2 class="hub-trust-heading" id="trust-heading">Focused tools, without the usual conversion overhead.</h2>
      <div class="hub-trust-grid"><div><span>✓</span><strong>No uploads</strong><p>Supported conversion work runs in the browser instead of through a remote upload queue.</p></div><div><span>→</span><strong>No account</strong><p>Open the exact tool and start. There is no registration step between the search and the converter.</p></div><div><span>1</span><strong>One clear job</strong><p>Each page stays focused on one conversion instead of becoming a heavyweight universal editor.</p></div></div>
    </section>

    <section class="hub-section hub-faq" aria-labelledby="faq-heading">
      <div><div class="hub-section-label">05 · Useful information</div><h2 id="faq-heading">Everything else, below the tools.</h2></div>
      <div class="hub-faq-list">
        <details><summary><span>01</span>Which file converters are available?<i>+</i></summary><p>LayerPorter currently includes JPG to PDF, PDF to JPG, WebP to JPG, Favicon Generator, PSD to PNG, PSD to JPG, PNG to PSD, JPG to PSD and the Canva to Google Slides compatibility checker.</p></details>
        <details><summary><span>02</span>Are files uploaded to a server?<i>+</i></summary><p>Where supported by the selected tool, processing runs locally in the browser on the device instead of through a remote upload queue.</p></details>
        <details><summary><span>03</span>What does Picture Converter add?<i>+</i></summary><p>Picture Converter adds more image formats and lets you convert selected images directly from websites in Chrome, as well as work with local image files.</p></details>
        <details><summary><span>04</span>Why does every conversion have its own page?<i>+</i></summary><p>Each page is built around one concrete job, so users can open the exact conversion they searched for instead of navigating a large all-purpose interface.</p></details>
      </div>
    </section>
  </div>
</BaseLayout>
