---
import LocalizedExactConverterLayout from '../../../layouts/LocalizedExactConverterLayout.astro';
import PdfToJpgWidgetPtBr from '../../../components/PdfToJpgWidgetPtBr.astro';
import NetworkGuard from '../../../components/NetworkGuard.astro';
import { CONVERT_HUB_LOCALES } from '../../../data/convertHubLocales';

const locale = CONVERT_HUB_LOCALES.find((item) => item.code === 'pt-br');
if (!locale) throw new Error('PT-BR converter locale config is missing');

const site = 'https://layerporter.com';
const canonicalPath = '/pt-br/convert/pdf-to-jpg/';
const pageUrl = `${site}${canonicalPath}`;
const title = 'Converter PDF para JPG Grátis no Navegador | LayerPorter';
const description = 'Converta PDF para JPG grátis no navegador. Cada página vira uma imagem JPG, sem upload e sem cadastro. Até 50 MB e 100 páginas; ZIP para mais de 3 páginas.';
const h1 = 'Converter PDF para JPG — grátis, sem upload';
const answerFirst = 'Use este conversor PDF para JPG para transformar cada página do documento em uma imagem JPG diretamente no navegador. Todas as páginas são convertidas; não há seletor de intervalo nesta versão. PDFs com até 50 MB e 100 páginas são aceitos, e documentos com mais de 3 páginas são baixados em ZIP. O PDF não é enviado para um servidor.';

const howTo = [
  { title: 'Escolha o PDF', text: 'Arraste um arquivo .pdf para o conversor ou clique para escolher um documento no seu dispositivo.' },
  { title: 'Renderize localmente', text: 'O navegador abre o PDF e renderiza todas as páginas no seu dispositivo, sem enviar o documento para um servidor.' },
  { title: 'Confira as prévias', text: 'Cada página aparece como uma prévia JPG para você conferir a ordem e o resultado antes do download.' },
  { title: 'Baixe os JPGs', text: 'Uma página gera um JPG; duas ou três páginas ficam disponíveis separadamente; com mais de três páginas, o conjunto é baixado em ZIP.' },
];

const faq = [
  { q: 'Como converter PDF para JPG grátis?', a: 'Escolha um PDF ou arraste-o para o conversor. Todas as páginas são renderizadas como JPG no navegador e ficam disponíveis para download sem cadastro e sem enviar o PDF para um servidor.' },
  { q: 'Posso escolher apenas algumas páginas do PDF?', a: 'Não nesta versão. Todas as páginas do documento são convertidas. Se você precisa de apenas uma parte do PDF, mantenha somente os JPGs desejados depois da conversão.' },
  { q: 'O texto continua selecionável no JPG?', a: 'Não. Cada página vira uma imagem plana, então textos, vetores e outros elementos passam a ser pixels no JPG.' },
  { q: 'PDF protegido por senha funciona?', a: 'Não diretamente. O mecanismo atual não abre PDFs protegidos por senha neste fluxo. Desbloqueie o documento em uma ferramenta apropriada antes de converter.' },
  { q: 'Qual é o limite de tamanho e páginas?', a: 'Nesta versão, o PDF pode ter até 50 MB e no máximo 100 páginas. Esses limites são verificados antes da renderização completa.' },
  { q: 'Quando o resultado é baixado em ZIP?', a: 'Documentos com mais de 3 páginas são reunidos em um ZIP. PDFs de 2 ou 3 páginas oferecem links separados; um PDF de uma página gera um único JPG.' },
  { q: 'Qual é a qualidade do JPG?', a: 'O mecanismo atual renderiza cada página em escala 2× e codifica o JPG com qualidade 92%. O resultado é uma imagem rasterizada e não mantém a precisão vetorial infinita do PDF.' },
  { q: 'Meu PDF é enviado para o LayerPorter?', a: 'Não. A leitura do PDF, a renderização das páginas e a criação dos arquivos acontecem no seu navegador durante esta conversão.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'LayerPorter', item: `${site}/pt-br/` },
        { '@type': 'ListItem', position: 2, name: 'Conversores', item: `${site}/pt-br/convert/` },
        { '@type': 'ListItem', position: 3, name: 'Converter PDF para JPG', item: pageUrl },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#app`,
      name: 'LayerPorter Converter PDF para JPG',
      url: pageUrl,
      description: answerFirst,
      inLanguage: 'pt-BR',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
      featureList: 'Converte todas as páginas de um PDF em JPG no navegador, aceita até 50 MB e 100 páginas e cria ZIP automaticamente quando há mais de 3 páginas',
    },
    {
      '@type': 'HowTo',
      '@id': `${pageUrl}#howto`,
      name: 'Como converter PDF para JPG no navegador',
      inLanguage: 'pt-BR',
      step: howTo.map((step) => ({ '@type': 'HowToStep', name: step.title, text: step.text })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      inLanguage: 'pt-BR',
      mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
    },
  ],
};
---

<LocalizedExactConverterLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  lang="pt-BR"
  dir="ltr"
  homePath="/pt-br/"
  extensionsPath="/pt-br/extensions/"
  learnPath="/pt-br/#workflows"
  headerLabels={locale.nav}
  footerLabels={locale.footer}
  alternates={[
    { hreflang: 'en', href: `${site}/convert/pdf-to-jpg/` },
    { hreflang: 'pt-BR', href: pageUrl },
    { hreflang: 'x-default', href: `${site}/convert/pdf-to-jpg/` },
  ]}
  ogTitle="Converter PDF para JPG Grátis — sem upload | LayerPorter"
  ogDescription="Transforme cada página do PDF em JPG direto no navegador. Até 50 MB e 100 páginas, sem upload e sem cadastro."
  ogImage={`${site}/og/pdf-to-jpg.png`}
  h1={h1}
  answerFirst={answerFirst}
  proofChips={['Sem upload', 'Sem cadastro', 'Até 100 páginas', 'ZIP com mais de 3 páginas']}
  expectationLeft={{
    title: 'PDF (entrada)',
    items: ['Documento com uma ou várias páginas', 'Até 50 MB e 100 páginas', 'Texto e vetores ainda estruturados no PDF'],
  }}
  expectationRight={{
    title: 'JPG (resultado)',
    items: ['Uma imagem plana por página', 'Texto deixa de ser selecionável', 'Todas as páginas são convertidas nesta versão'],
  }}
  truthNote="Esta página converte todas as páginas do PDF; não há seletor de intervalo nesta versão. PDFs protegidos por senha precisam ser desbloqueados antes da conversão."
  howTo={howTo}
  whatYouGet={[
    { title: 'Um JPG por página', text: 'A quantidade de imagens acompanha a quantidade de páginas do documento, mantendo a ordem original.' },
    { title: 'Prévia de todas as páginas', text: 'Cada JPG aparece em miniatura antes do download para facilitar a conferência do resultado.' },
    { title: 'ZIP para documentos maiores', text: 'Com mais de três páginas, todos os JPGs são reunidos automaticamente em um único arquivo ZIP.' },
    { title: 'Processamento local', text: 'O PDF é lido e renderizado na memória do navegador; o documento não é enviado durante esta conversão.' },
  ]}
  faq={faq}
  labels={{
    eyebrow: 'Conversor no navegador',
    subtitle: 'No seu dispositivo. Sem upload. Sem conta.',
    proofAria: 'Garantias do produto',
    expectationHeading: 'O que esperar',
    howHeading: 'Como converter PDF para JPG',
    whatYouGetHeading: 'O que você recebe',
    faqHeading: 'Perguntas frequentes',
    moreHeading: 'Mais conversores',
    allConverters: 'Ver todos os conversores',
  }}
  allConvertersHref="/pt-br/convert/"
  jsonLd={jsonLd}
>
  <Fragment slot="tool">
    <PdfToJpgWidgetPtBr toolHeading="Converter PDF para JPG" />
    <NetworkGuard />
  </Fragment>
</LocalizedExactConverterLayout>
