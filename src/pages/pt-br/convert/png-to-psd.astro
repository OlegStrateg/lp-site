---
import LocalizedExactConverterLayout from '../../../layouts/LocalizedExactConverterLayout.astro';
import ConverterWidgetV2 from '../../../components/ConverterWidgetV2.astro';
import NetworkGuard from '../../../components/NetworkGuard.astro';
import { CONVERT_HUB_LOCALES } from '../../../data/convertHubLocales';

const locale = CONVERT_HUB_LOCALES.find((item) => item.code === 'pt-br');
if (!locale) throw new Error('PT-BR converter locale config is missing');

const site = 'https://layerporter.com';
const canonicalPath = '/pt-br/convert/png-to-psd/';
const pageUrl = `${site}${canonicalPath}`;
const title = 'Converter PNG em PSD Grátis no Navegador | LayerPorter';
const description = 'Converta PNG em PSD grátis no navegador, sem upload. O PNG vira uma camada de imagem no PSD, com transparência preservada e download sem cadastro.';
const h1 = 'Converter PNG em PSD — grátis, sem upload';
const answerFirst = 'Use este conversor PNG para PSD para colocar uma imagem PNG em um arquivo PSD diretamente no navegador. O resultado contém uma camada de imagem com a transparência preservada; ele não reconstrói textos, botões, objetos ou fundos separados que já estavam achatados no PNG.';

const howTo = [
  { title: 'Adicione o PNG', text: 'Arraste uma imagem PNG para o conversor ou clique para escolher um arquivo no seu dispositivo.' },
  { title: 'Crie o PSD no navegador', text: 'O LayerPorter lê os pixels do PNG localmente e cria um arquivo PSD com uma camada de imagem, sem enviar o arquivo para um servidor.' },
  { title: 'Baixe ou abra no Photopea', text: 'Baixe o PSD pronto ou abra o resultado no Photopea para continuar editando e adicionar novas camadas.' },
];

const faq = [
  {
    q: 'Como converter PNG em PSD grátis?',
    a: 'Escolha um arquivo PNG ou arraste a imagem para o conversor. O PSD é criado no navegador e fica disponível para download sem cadastro e sem upload do arquivo.',
  },
  {
    q: 'O PSD terá camadas editáveis?',
    a: 'O resultado tem uma camada de imagem com os pixels do PNG. Você pode adicionar máscaras, ajustes e novas camadas depois, mas um PNG achatado não contém os elementos originais separados; este conversor não recria texto, botões, objetos ou fundos como camadas independentes.',
  },
  {
    q: 'A transparência do PNG é preservada no PSD?',
    a: 'Sim. O canal alfa do PNG é preservado na camada de imagem do PSD, então as áreas transparentes continuam transparentes.',
  },
  {
    q: 'Converter PNG para PSD perde qualidade?',
    a: 'Os pixels e as dimensões da imagem são mantidos. O conversor muda o contêiner para PSD e não aplica uma nova compressão JPEG à imagem PNG.',
  },
  {
    q: 'Qual é o limite do conversor PNG para PSD?',
    a: 'Nesta versão, o arquivo PNG pode ter até 30 MB e a imagem pode ter no máximo 6000×6000 pixels. A conversão é feita um arquivo por vez.',
  },
  {
    q: 'Preciso do Photoshop para converter PNG em PSD?',
    a: 'Não. A conversão acontece no navegador. Depois, você pode abrir o PSD no Photoshop, Photopea ou GIMP para continuar trabalhando no arquivo.',
  },
  {
    q: 'O arquivo PNG é enviado para um servidor?',
    a: 'Não. A leitura do PNG e a criação do PSD acontecem no seu dispositivo. O LayerPorter não envia o arquivo durante esta conversão.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'LayerPorter', item: `${site}/pt-br/` },
        { '@type': 'ListItem', position: 2, name: 'Conversores', item: `${site}/pt-br/convert/` },
        { '@type': 'ListItem', position: 3, name: 'Converter PNG em PSD', item: pageUrl },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#app`,
      name: 'LayerPorter Converter PNG em PSD',
      url: pageUrl,
      description: answerFirst,
      inLanguage: 'pt-BR',
      applicationCategory: 'DesignApplication',
      operatingSystem: 'Web',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
      featureList: 'Converte um PNG em PSD com uma camada de imagem, preserva transparência, aceita até 30 MB e 6000×6000 pixels e processa o arquivo localmente no navegador',
    },
    {
      '@type': 'HowTo',
      '@id': `${pageUrl}#howto`,
      name: 'Como converter PNG para PSD no navegador',
      inLanguage: 'pt-BR',
      step: howTo.map((step) => ({ '@type': 'HowToStep', name: step.title, text: step.text })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      inLanguage: 'pt-BR',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<LocalizedExactConverterLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  lang="pt-BR"
  dir="ltr"
  homePath="/pt-br/"
  extensionsPath="/pt-br/extensions/"
  learnPath="/pt-br/#workflows"
  headerLabels={locale.nav}
  footerLabels={locale.footer}
  alternates={[
    { hreflang: 'en', href: `${site}/convert/png-to-psd/` },
    { hreflang: 'pt-BR', href: pageUrl },
    { hreflang: 'x-default', href: `${site}/convert/png-to-psd/` },
  ]}
  ogTitle="Converter PNG em PSD Grátis — sem upload | LayerPorter"
  ogDescription="Converta PNG para PSD no navegador. Uma camada de imagem, transparência preservada, até 30 MB e sem enviar o arquivo."
  ogImage={`${site}/og/png-to-psd.png`}
  h1={h1}
  answerFirst={answerFirst}
  proofChips={['Sem upload', 'Sem cadastro', 'Transparência preservada', 'Uma camada de imagem']}
  expectationLeft={{
    title: 'PNG (entrada)',
    items: ['Um arquivo por conversão', 'Até 30 MB e 6000×6000 px', 'Pixels achatados; pode ter transparência'],
  }}
  expectationRight={{
    title: 'PSD (resultado)',
    items: ['Uma camada de imagem', 'Transparência preservada', 'Pronto para Photoshop, Photopea ou GIMP'],
  }}
  truthNote="Um PNG é uma imagem achatada. Este conversor cria um PSD com uma camada de imagem; ele não separa novamente texto, botões, objetos ou fundos que já foram rasterizados no PNG."
  howTo={howTo}
  whatYouGet={[
    { title: 'Uma camada de imagem', text: 'Os pixels do PNG entram em uma camada própria no PSD, pronta para receber máscaras, ajustes e novas camadas.' },
    { title: 'Transparência preservada', text: 'O canal alfa é mantido pixel a pixel, então as áreas transparentes continuam transparentes no PSD.' },
    { title: 'PSD padrão', text: 'O mesmo mecanismo do conversor em inglês gera o arquivo PSD e o projeto valida o caminho de escrita e leitura em seus testes de build.' },
    { title: 'Processamento local', text: 'A conversão acontece na memória do navegador. O arquivo PNG não é enviado para o LayerPorter.' },
  ]}
  faq={faq}
  labels={{
    eyebrow: 'Conversor no navegador',
    subtitle: 'No seu dispositivo. Sem upload. Sem conta.',
    proofAria: 'Garantias do produto',
    expectationHeading: 'O que esperar',
    howHeading: 'Como converter PNG em PSD',
    whatYouGetHeading: 'O que você recebe',
    faqHeading: 'Perguntas frequentes',
    moreHeading: 'Mais conversores',
    allConverters: 'Ver todos os conversores',
  }}
  allConvertersHref="/pt-br/convert/"
  jsonLd={jsonLd}
>
  <Fragment slot="tool">
    <ConverterWidgetV2
      toolHeading="Converter PNG para PSD"
      showExtensionBridge={false}
      labels={{
        ariaLabel: 'Conversor de PNG para PSD',
        dropTitle: 'Solte o PNG aqui',
        dropSubtitle: 'ou escolha um arquivo PNG no seu dispositivo',
        choose: 'Escolher PNG',
        hint: 'Somente PNG · processado localmente',
        privacy: 'Dados do arquivo enviados: 0 B',
        processingNoUpload: 'Nenhum dado do arquivo está sendo enviado.',
        successBadge: 'Conversão concluída no dispositivo',
        successTitle: 'Seu PSD está pronto',
        previewAlt: 'Prévia da imagem convertida sobre fundo quadriculado',
        layerPill: 'Uma camada de imagem',
        transparencyPreserved: 'Transparência preservada',
        opaqueImage: 'Imagem sem transparência',
        download: 'Baixar PSD',
        photopea: 'Abrir no Photopea',
        convertAnother: 'Converter outro PNG',
        errorDefault: 'Não foi possível processar este arquivo. Tentar novamente?',
        jpgErrorLead: 'Este arquivo parece ser JPG →',
        jpgBridgeLabel: 'Conversor JPG para PSD',
        jpgBridgeHref: '/convert/jpg-to-psd/',
        retry: 'Tentar novamente',
        announceConverting: 'Convertendo…',
        announceSuccess: 'Concluído. Seu PSD está pronto para baixar.',
        jpgNotPng: 'Este arquivo parece ser JPG, não PNG.',
        notPng: 'Este arquivo não parece ser PNG. Escolha um arquivo .png.',
        tooLarge: 'Este arquivo tem mais de 30 MB. Escolha uma imagem menor.',
        tooLargeDimensions: 'Esta imagem ultrapassa {max}×{max}px. Escolha uma imagem menor.',
        corrupt: 'Não foi possível ler este arquivo. Ele pode estar corrompido ou em um formato não compatível.',
        stageRead: 'Lendo PNG…',
        stageBuild: 'Criando o arquivo PSD…',
        stagePrepare: 'Preparando o download…',
        conversionFailed: 'A conversão falhou. Tente novamente.',
        unexpectedFailed: 'A conversão falhou inesperadamente. Tente novamente.',
      }}
    />
    <NetworkGuard />
  </Fragment>
</LocalizedExactConverterLayout>