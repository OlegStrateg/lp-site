---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageWorkspaceNav from '../../components/ImageWorkspaceNav.astro';
import '../../styles/image-tools.css';

const title = 'Meme Generator Online — Add Text to Images | LayerPorter';
const description = 'Create memes directly on the image with draggable, resizable and editable text. Add captions, outlines, backgrounds and download in your browser.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/tools/meme-generator/"
  clientRouter={true}
  headerLabels={{ converters: 'Converters', extensions: 'Extensions', learn: 'Learn', mainAria: 'Main', localEngine: 'Browser processing', localTitle: 'Image processing runs in your browser' }}
  footerLabels={{ tagline: 'LayerPorter — focused browser tools for files and media.', about: 'About', extensions: 'Extensions', privacy: 'Privacy', terms: 'Terms', footerAria: 'Footer' }}
>
  <script is:inline slot="head">
    (() => {
      try {
        const params = new URLSearchParams(window.location.search);
        const token = params.get('lp_edit_token') || '';
        const extensionId = params.get('lp_extension_id') || '';
        if (/^[A-Za-z0-9_-]{20,160}$/.test(token) && /^[a-p]{32}$/.test(extensionId)) {
          document.documentElement.dataset.lpWorkspaceState = 'loading';
          document.documentElement.dataset.lpExtensionImport = 'pending';
        }
      } catch {}
    })();
  </script>

  <section class="image-tool-hero meme-tool-hero" aria-labelledby="meme-title">
    <div class="image-tool-copy">
      <p class="image-tool-kicker">Meme maker</p>
      <h1 id="meme-title">Meme generator</h1>
      <p class="image-tool-lede">Edit text directly on the image — move it, resize it, rotate it and style it where you see it.</p>
    </div>

    <div class="image-workspace-frame meme-editor-frame" transition:name="image-workspace-frame">
      <ImageWorkspaceNav active="meme" />

      <div class="image-tool-shell meme-editor-shell" id="meme-image-tool" data-state="empty">
        <input id="meme-file" class="visually-hidden" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
        <input id="meme-overlay-file" class="visually-hidden" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />

        <label class="image-tool-drop" id="meme-drop" for="meme-file" tabindex="0">
          <span class="image-tool-drop-icon" aria-hidden="true">＋</span>
          <strong>Choose an image</strong>
          <small>or drop JPG, PNG or WebP here</small>
        </label>

        <div class="meme-editor-workspace" id="meme-workspace" hidden>
          <div class="meme-canvas-area" id="meme-canvas-area">
            <div class="meme-stage" id="meme-stage">
              <img id="meme-stage-image" alt="" draggable="false" />
              <div class="meme-object-layer" id="meme-object-layer"></div>
            </div>

            <div class="meme-floating-toolbar" id="meme-floating-toolbar" hidden>
              <select id="meme-toolbar-font" class="meme-text-control meme-toolbar-select" aria-label="Font">
                <option value="Impact">Impact</option>
                <option value="Arial Black">Arial Black</option>
                <option value="Arial">Arial</option>
                <option value="Verdana">Verdana</option>
                <option value="Georgia">Georgia</option>
                <option value="Times New Roman">Times New Roman</option>
              </select>
              <input id="meme-toolbar-size" class="meme-text-control meme-toolbar-number" type="number" min="8" max="4096" aria-label="Font size" />
              <button id="meme-toolbar-bold" class="meme-text-control meme-toolbar-button" type="button" title="Bold" aria-label="Bold"><strong>B</strong></button>
              <button id="meme-toolbar-italic" class="meme-text-control meme-toolbar-button" type="button" title="Italic" aria-label="Italic"><em>I</em></button>
              <button id="meme-toolbar-underline" class="meme-text-control meme-toolbar-button" type="button" title="Underline" aria-label="Underline"><u>U</u></button>
              <button id="meme-toolbar-uppercase" class="meme-text-control meme-toolbar-button" type="button" title="Uppercase" aria-label="Uppercase">Tt</button>
              <label class="meme-toolbar-color" title="Text color" aria-label="Text color">
                <span>A</span><input id="meme-toolbar-fill" type="color" value="#ffffff" />
              </label>
              <label class="meme-toolbar-color" title="Outline color" aria-label="Outline color">
                <span>◫</span><input id="meme-toolbar-stroke" type="color" value="#000000" />
              </label>
              <input id="meme-toolbar-stroke-width" class="meme-text-control meme-toolbar-number meme-toolbar-stroke-width" type="number" min="0" max="200" title="Outline width" aria-label="Outline width" />
              <button id="meme-toolbar-align" class="meme-text-control meme-toolbar-button" type="button" title="Text alignment" aria-label="Text alignment">≡</button>
              <button id="meme-toolbar-background" class="meme-text-control meme-toolbar-button" type="button" title="Text background" aria-label="Text background">▦</button>
              <span class="meme-toolbar-divider" aria-hidden="true"></span>
              <button id="meme-toolbar-duplicate" class="meme-toolbar-button" type="button" title="Duplicate text" aria-label="Duplicate text">⧉</button>
              <button id="meme-toolbar-delete" class="meme-toolbar-button is-danger" type="button" title="Delete text" aria-label="Delete text">✕</button>
            </div>

            <div class="meme-canvas-meta">
              <span id="meme-file-meta"></span>
              <span>Click to select · drag to move · corners resize · top handle rotates · double click edits</span>
            </div>
          </div>

          <aside class="meme-side-panel" aria-label="Meme editor controls">
            <div class="meme-side-title">
              <span class="image-tool-mode-label">Meme</span>
              <h2>Meme editor</h2>
            </div>

            <div class="meme-mode-grid">
              <button class="meme-mode-card is-active" id="meme-mode-inside" type="button" aria-pressed="true">
                <span class="meme-mode-icon">▣</span>
                <strong>Text inside</strong>
                <small>Place text over the image</small>
              </button>
              <button class="meme-mode-card" id="meme-mode-outside" type="button" aria-pressed="false">
                <span class="meme-mode-icon">▤</span>
                <strong>Text outside</strong>
                <small>Add caption space above and below</small>
              </button>
            </div>

            <div class="meme-side-actions">
              <button class="meme-side-action" id="meme-add-image" type="button">
                <span aria-hidden="true">▧</span>
                <strong>Add image</strong>
              </button>
              <button class="meme-side-action" id="meme-add-text" type="button">
                <span aria-hidden="true">A</span>
                <strong>Add text</strong>
              </button>
            </div>
            <button class="meme-replace-link" id="meme-replace-image" type="button">Replace base image</button>

            <div class="image-tool-status meme-editor-status" id="meme-status" role="status" aria-live="polite"></div>

            <div class="meme-export-actions">
              <button class="image-tool-primary" id="meme-action" type="button" disabled>Apply to workspace</button>
              <button class="image-tool-download meme-download-button" id="meme-download" type="button" disabled>Download meme</button>
            </div>
          </aside>
        </div>
      </div>
    </div>

    <div class="image-tool-supporting-copy">
      <p>Direct editing, multiple text and image objects, and local browser rendering. Apply the result to the same LayerPorter Workspace and continue with Crop or Resize.</p>
      <div class="image-tool-badges" aria-label="Meme generator features">
        <span>Text + image objects</span>
        <span>Drag · resize · rotate</span>
        <span>Text inside / outside</span>
        <span>JPG, PNG, WebP</span>
      </div>
    </div>
  </section>

  <section class="image-tool-info" aria-labelledby="meme-how-title">
    <div>
      <p class="image-tool-section-label">How it works</p>
      <h2 id="meme-how-title">Edit the meme where you see it.</h2>
    </div>
    <ol class="image-tool-steps">
      <li><span>01</span><div><strong>Choose an image</strong><p>Open a JPG, PNG or WebP image. Two classic meme text objects appear automatically.</p></div></li>
      <li><span>02</span><div><strong>Edit directly on the image</strong><p>Drag text, resize it from the corners, rotate it from the top handle and double click to type directly.</p></div></li>
      <li><span>03</span><div><strong>Download or continue editing</strong><p>Download the meme, or apply it to the shared Workspace and continue in Crop or Resize.</p></div></li>
    </ol>
  </section>

  <section class="image-tool-faq" aria-labelledby="meme-faq-title">
    <p class="image-tool-section-label">FAQ</p>
    <h2 id="meme-faq-title">Meme generator questions</h2>
    <details><summary>Can I move and resize text directly?</summary><p>Yes. Select a text object, drag it to move, use the corner handles to resize and the top handle to rotate it.</p></details>
    <details><summary>Can I type directly on the image?</summary><p>Yes. Double click a text object and edit the wording directly in place.</p></details>
    <details><summary>What is Text outside?</summary><p>It adds clean caption space above and below the image so text does not cover the photo.</p></details>
    <details><summary>Does LayerPorter upload my image?</summary><p>The meme is rendered in your browser. The image processing runtime does not need a remote image-processing service.</p></details>
  </section>

  <script>
    import { installImageWorkspaceBootstrap } from '../../scripts/imageWorkspaceBootstrap';
    installImageWorkspaceBootstrap();
  </script>
</BaseLayout>
