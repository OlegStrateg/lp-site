---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Virtual Try-On — Ready Core Candidate | LayerPorter';
const description = 'LP-098 candidate powered by the tested browser-native try-on reference engine while LayerPorter self-hosting integration is completed.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/tools/virtual-try-on/"
  robots="noindex, nofollow, noarchive, nosnippet, noimageindex"
  headerLabels={{
    converters: 'Converters',
    extensions: 'Extensions',
    learn: 'Learn',
    mainAria: 'Main',
    localEngine: 'On-device preview',
    localTitle: 'The try-on engine runs in the browser; this candidate uses the upstream reference deployment.',
  }}
  footerLabels={{
    tagline: 'LayerPorter — focused browser tools for files, images and media.',
    about: 'About',
    extensions: 'Extensions',
    privacy: 'Privacy',
    terms: 'Terms',
    footerAria: 'Footer',
  }}
>
  <section class="vto-ready" aria-labelledby="vto-title">
    <div class="vto-head">
      <div>
        <p class="vto-kicker">LP-098 · READY CORE CANDIDATE</p>
        <h1 id="vto-title">Virtual Try-On</h1>
        <p class="vto-lede">
          This candidate intentionally disables the rejected LayerPorter custom warp prototype and runs the proven browser-native reference engine instead. The next engineering step is self-hosting the same core inside LayerPorter — not inventing a second try-on pipeline.
        </p>
      </div>
      <div class="vto-state" role="note">
        <strong>Candidate only</strong>
        <span>No production merge. No indexation. Upstream engine is isolated while we validate the mechanics.</span>
      </div>
    </div>

    <div class="vto-frame-shell">
      <div class="vto-frame-bar">
        <div><span class="vto-dot"></span><strong>Ready core</strong><small>pravoobi/try-on · browser-native</small></div>
        <a href="https://pravoobi.github.io/try-on/" target="_blank" rel="noopener noreferrer">Open full screen ↗</a>
      </div>
      <iframe
        class="vto-frame"
        src="https://pravoobi.github.io/try-on/"
        title="Virtual Try-On ready-core candidate"
        allow="camera; clipboard-write"
        loading="eager"
      ></iframe>
    </div>

    <div class="vto-gates">
      <div><strong>What changed</strong><p>The old code that stretched an arbitrary uploaded image over the torso is no longer used by this test path.</p></div>
      <div><strong>What we validate now</strong><p>Real segmentation, pose estimation, TPS garment warp, occlusion and the upstream garment-upload flow.</p></div>
      <div><strong>What comes next</strong><p>Vendor the same MIT core into LayerPorter, pin models/runtime, then add our UX and multi-person garment selection without changing the core mechanics.</p></div>
    </div>
  </section>

  <style>
    .vto-ready{max-width:1240px;margin:0 auto;padding:58px 0 82px}.vto-head{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:36px;align-items:end;margin-bottom:26px}.vto-kicker{margin:0 0 12px;color:#6b5dd3;font-size:11px;font-weight:850;letter-spacing:.1em}.vto-head h1{margin:0;font-size:clamp(48px,7vw,82px);line-height:.93;letter-spacing:-.058em}.vto-lede{max-width:820px;margin:20px 0 0;color:#62656f;font-size:17px;line-height:1.58}.vto-state{display:grid;gap:7px;padding:15px 16px;border:1px solid #e0d8b9;border-radius:14px;background:#fff8e8}.vto-state strong{font-size:12px}.vto-state span{color:#6f6653;font-size:11px;line-height:1.45}.vto-frame-shell{overflow:hidden;border:1px solid #dadde5;border-radius:20px;background:#11131a;box-shadow:0 24px 70px rgba(25,29,42,.12)}.vto-frame-bar{height:48px;padding:0 15px;display:flex;align-items:center;justify-content:space-between;gap:18px;background:#11131a;color:#fff}.vto-frame-bar>div{display:flex;align-items:center;gap:8px}.vto-frame-bar strong{font-size:12px}.vto-frame-bar small{color:#9096a5;font-size:10px}.vto-frame-bar a{color:#fff;text-decoration:none;font-size:11px;font-weight:800}.vto-dot{width:8px;height:8px;border-radius:50%;background:#6ddd9a;box-shadow:0 0 0 3px rgba(109,221,154,.13)}.vto-frame{display:block;width:100%;height:900px;border:0;background:#fff}.vto-gates{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}.vto-gates>div{padding:15px 16px;border:1px solid #e1e3e8;border-radius:14px;background:#fff}.vto-gates strong{font-size:12px}.vto-gates p{margin:6px 0 0;color:#6d717b;font-size:11px;line-height:1.5}@media(max-width:850px){.vto-head{grid-template-columns:1fr}.vto-frame{height:760px}.vto-gates{grid-template-columns:1fr}}@media(max-width:520px){.vto-ready{padding:38px 0 58px}.vto-head h1{font-size:48px}.vto-frame-bar small{display:none}.vto-frame{height:700px}}
  </style>
</BaseLayout>
