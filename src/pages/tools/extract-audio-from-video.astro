---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Extract Audio from Video Online — MP3 | LayerPorter';
const description = 'Extract an MP3 audio track from a local MP4, MOV, WebM or MKV video in your browser. No account required. Files up to 250 MB.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/tools/extract-audio-from-video/"
  headerLabels={{
    converters: 'Converters',
    extensions: 'Extensions',
    learn: 'Learn',
    mainAria: 'Main',
    localEngine: 'Browser processing',
    localTitle: 'Media processing runs in your browser',
  }}
  footerLabels={{
    tagline: 'LayerPorter — focused browser tools for files and media.',
    about: 'About',
    extensions: 'Extensions',
    privacy: 'Privacy',
    terms: 'Terms',
    footerAria: 'Footer',
  }}
>
  <section class="audio-hero" aria-labelledby="audio-title">
    <div class="audio-copy">
      <p class="audio-kicker">Video → MP3</p>
      <h1 id="audio-title">Extract audio from video</h1>
      <p class="audio-lede">Choose a local video, extract its audio track, and download a playable MP3. No account required.</p>
      <div class="audio-limits" aria-label="Supported files and limits">
        <span>MP4, M4V, MOV, WebM, MKV</span>
        <span>Up to 250 MB</span>
        <span>MP3 · 320 kbps</span>
      </div>
    </div>

    <div class="audio-tool" id="extract-audio-tool" data-state="empty">
      <input
        id="eav-file"
        class="visually-hidden"
        type="file"
        accept="video/mp4,video/quicktime,video/webm,video/x-matroska,.mp4,.m4v,.mov,.webm,.mkv"
      />

      <label class="audio-drop" id="eav-drop" for="eav-file" tabindex="0">
        <span class="audio-drop-icon" aria-hidden="true">＋</span>
        <strong>Choose a video</strong>
        <small>or drop it here</small>
      </label>

      <div class="audio-job" id="eav-job" hidden>
        <div class="audio-file-row">
          <div>
            <strong id="eav-file-label">Video selected</strong>
            <span id="eav-file-meta"></span>
          </div>
          <button class="audio-link-button" id="eav-change" type="button">Choose another</button>
        </div>

        <div class="audio-status" id="eav-status" role="status" aria-live="polite">Checking the audio track…</div>
        <progress id="eav-progress" max="1" value="0" hidden>0%</progress>

        <button class="audio-primary" id="eav-extract" type="button" disabled>Extract MP3</button>
      </div>

      <div class="audio-result" id="eav-result" hidden>
        <div class="audio-result-mark" aria-hidden="true">✓</div>
        <div>
          <strong>MP3 is ready</strong>
          <span id="eav-result-meta">320 kbps</span>
        </div>
        <audio id="eav-player" controls preload="metadata"></audio>
        <a class="audio-primary audio-download" id="eav-download" href="#" download>Download MP3</a>
        <button class="audio-link-button" id="eav-again" type="button">Extract from another video</button>
      </div>
    </div>

    <p class="audio-pinterest" id="eav-pinterest-note" hidden>
      Coming from Pinterest Downloader? Select the video you already downloaded and extract its audio here.
    </p>
  </section>

  <section class="audio-info" aria-labelledby="how-title">
    <div>
      <p class="audio-section-label">How it works</p>
      <h2 id="how-title">Three steps, one result.</h2>
    </div>
    <ol class="audio-steps">
      <li><span>01</span><div><strong>Select a video</strong><p>Use a local MP4, M4V, MOV, WebM or MKV file up to 250 MB.</p></div></li>
      <li><span>02</span><div><strong>Extract the audio</strong><p>The browser reads the primary audio track and converts it to MP3 at 320 kbps.</p></div></li>
      <li><span>03</span><div><strong>Play or download</strong><p>Preview the result in the page, then download the MP3 file.</p></div></li>
    </ol>
  </section>

  <section class="audio-info audio-details" aria-labelledby="support-title">
    <div>
      <p class="audio-section-label">Support</p>
      <h2 id="support-title">What this version handles.</h2>
    </div>
    <div class="audio-table" role="list">
      <div role="listitem"><strong>Input containers</strong><span>MP4, M4V, MOV, WebM, MKV</span></div>
      <div role="listitem"><strong>Output</strong><span>MP3 · 320 kbps</span></div>
      <div role="listitem"><strong>File size</strong><span>Maximum 250 MB</span></div>
      <div role="listitem"><strong>Audio track</strong><span>The video must contain a browser-decodable audio track</span></div>
      <div role="listitem"><strong>Not in this web version</strong><span>AVI, HLS/DASH URLs, DRM streams, YouTube links</span></div>
    </div>
  </section>

  <section class="audio-faq" aria-labelledby="faq-title">
    <p class="audio-section-label">FAQ</p>
    <h2 id="faq-title">Common questions</h2>
    <details>
      <summary>What audio format do I get?</summary>
      <p>This version exports one format: MP3 at 320 kbps.</p>
    </details>
    <details>
      <summary>What happens if the video has no sound?</summary>
      <p>The tool checks for a primary audio track before extraction and shows a clear error if none is present.</p>
    </details>
    <details>
      <summary>Why can a supported video container still fail?</summary>
      <p>A container such as MP4 or MKV can hold different audio codecs. If the browser cannot decode that codec, the tool stops before conversion and reports the limitation.</p>
    </details>
    <details>
      <summary>Can I process another video without reloading the page?</summary>
      <p>Yes. Use “Extract from another video” or “Choose another” and select the next file.</p>
    </details>
    <p class="audio-notices"><a href="/tools/extract-audio-from-video/THIRD_PARTY_NOTICES.txt">Third-party notices</a></p>
  </section>

  <style>
    .audio-hero{padding:72px 0 84px;max-width:1040px;margin:0 auto}.audio-copy{text-align:center;max-width:820px;margin:0 auto 34px}.audio-kicker,.audio-section-label{margin:0 0 12px;color:#6b5dd3;font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.audio-copy h1{margin:0;font-size:clamp(44px,7vw,78px);line-height:.96;letter-spacing:-.055em}.audio-lede{max-width:700px;margin:22px auto 0;color:#62656f;font-size:19px;line-height:1.55}.audio-limits{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin-top:24px}.audio-limits span{padding:8px 11px;border:1px solid #dedfe6;border-radius:999px;background:#fff;color:#555965;font-size:12px;font-weight:700}.audio-tool{max-width:820px;margin:0 auto;padding:18px;border:1px solid #dfe1e8;border-radius:22px;background:#fff;box-shadow:0 22px 65px rgba(30,33,45,.08)}.visually-hidden{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.audio-drop{min-height:260px;border:2px dashed #cfd2dc;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:#fafafd;cursor:pointer;transition:border-color .16s,background .16s,transform .16s}.audio-drop:hover,.audio-drop.is-dragging{border-color:#8276e8;background:#f7f5ff;transform:translateY(-1px)}.audio-drop:focus-visible,.audio-primary:focus-visible,.audio-link-button:focus-visible,.audio-download:focus-visible{outline:3px solid rgba(130,118,232,.24);outline-offset:3px}.audio-drop-icon{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:#11131a;color:#fff;font-size:26px;line-height:1}.audio-drop strong{font-size:18px}.audio-drop small{color:#7b7f89}.audio-job{padding:8px 4px 4px}.audio-file-row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:4px 2px 18px;border-bottom:1px solid #ececf1}.audio-file-row>div{min-width:0}.audio-file-row strong{display:block;font-size:16px}.audio-file-row span{display:block;margin-top:5px;color:#777b85;font-size:12px}.audio-status{min-height:24px;margin:20px 0 10px;color:#5f636d;font-size:14px}.audio-status.is-error{color:#b42318}.audio-status.is-success{color:#087443}.audio-tool progress{width:100%;height:10px;margin:0 0 18px;accent-color:#8276e8}.audio-primary{width:100%;min-height:52px;border:0;border-radius:12px;background:#11131a;color:#fff;font:inherit;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none}.audio-primary:disabled{cursor:not-allowed;opacity:.42}.audio-link-button{border:0;background:transparent;color:#6658cd;font:inherit;font-size:13px;font-weight:750;cursor:pointer;padding:7px}.audio-result{padding:22px 6px 6px;display:grid;grid-template-columns:46px 1fr;gap:6px 14px;align-items:center}.audio-result[hidden]{display:none}.audio-result-mark{grid-row:1;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#e9f8ef;color:#087443;font-weight:900}.audio-result>div:nth-child(2) strong{display:block;font-size:17px}.audio-result>div:nth-child(2) span{display:block;margin-top:3px;color:#757984;font-size:12px}.audio-result audio{grid-column:1/-1;width:100%;margin:16px 0 8px}.audio-download{grid-column:1/-1}.audio-result>.audio-link-button{grid-column:1/-1;justify-self:center;margin-top:5px}.audio-pinterest{max-width:820px;margin:14px auto 0;color:#666a74;font-size:13px;text-align:center}.audio-info,.audio-faq{max-width:1040px;margin:0 auto;padding:80px 0;border-top:1px solid #e5e6eb}.audio-info{display:grid;grid-template-columns:.75fr 1.25fr;gap:72px}.audio-info h2,.audio-faq h2{margin:0;font-size:clamp(34px,4vw,52px);line-height:1;letter-spacing:-.045em}.audio-steps{list-style:none;padding:0;margin:0}.audio-steps li{display:grid;grid-template-columns:48px 1fr;gap:16px;padding:22px 0;border-top:1px solid #e7e8ed}.audio-steps li:first-child{border-top:0;padding-top:0}.audio-steps li>span{color:#8a8e98;font-size:12px;font-weight:800}.audio-steps strong{font-size:17px}.audio-steps p{margin:7px 0 0;color:#676b75;line-height:1.55}.audio-table{border-top:1px solid #dadce3}.audio-table>div{display:grid;grid-template-columns:.8fr 1.2fr;gap:20px;padding:17px 0;border-bottom:1px solid #e5e6eb;font-size:14px}.audio-table span{color:#666a74}.audio-faq{max-width:820px}.audio-faq h2{margin-bottom:30px}.audio-faq details{border-top:1px solid #e2e3e9;padding:18px 0}.audio-faq summary{cursor:pointer;font-weight:800}.audio-faq details p{margin:11px 0 0;color:#666a74;line-height:1.6}.audio-notices{margin:26px 0 0;font-size:12px}.audio-notices a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.audio-hero{padding:46px 0 62px}.audio-copy{text-align:left}.audio-limits{justify-content:flex-start}.audio-tool{padding:12px;border-radius:17px}.audio-drop{min-height:220px}.audio-file-row{align-items:flex-start}.audio-info{grid-template-columns:1fr;gap:34px;padding:62px 0}.audio-table>div{grid-template-columns:1fr;gap:6px}.audio-faq{padding:62px 0}}
  </style>

  <script>
    import { initExtractAudioTool } from '../../scripts/extractAudioTool';
    initExtractAudioTool();
  </script>
</BaseLayout>
