---
import PageLayout from '../layouts/PageLayout.astro';

const reasons = [
  { key: 'capture', label: "Couldn't download what I needed" },
  { key: 'missing-feature', label: 'A feature was missing' },
  { key: 'slow-crash', label: 'Too slow or errors' },
  { key: 'found-alternative', label: 'Found another tool' },
  { key: 'unsure-how', label: "Didn't understand how to use it" },
  { key: 'trying-out', label: 'I was just trying it' },
  { key: 'privacy', label: 'Permissions or privacy' },
  { key: 'other', label: 'Something else' },
];
---

<PageLayout
  title="Pinterest Downloader removed — LayerPorter"
  description="Tell us why you removed Pinterest Downloader. One quick answer helps us decide what to improve next."
  canonicalPath="/uninstall/"
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <style is:global>
      .site-header,
      .site-footer {
        display: none !important;
      }

      body {
        margin: 0;
        background: #f7f7f5;
        color: #111;
      }

      main.wrap {
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .page-prose {
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .uninstall-page,
      .uninstall-page * {
        box-sizing: border-box;
      }

      .uninstall-page {
        min-height: 100vh;
        padding: 28px 20px 48px;
        font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .uninstall-shell {
        width: min(100%, 760px);
        margin: 0 auto;
      }

      .uninstall-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        margin-bottom: 28px;
        color: #7a7a75;
        font-size: 13px;
        font-weight: 760;
        letter-spacing: 0.02em;
      }

      .uninstall-brand span {
        color: #111;
      }

      .uninstall-hero {
        text-align: center;
      }

      .product-lockup {
        width: fit-content;
        max-width: 100%;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 8px 12px 8px 8px;
        border: 1px solid #e1e1dc;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.72);
        box-shadow: 0 1px 2px rgba(17, 17, 17, 0.04);
        text-align: left;
      }

      .product-lockup img {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        object-fit: cover;
        flex: 0 0 auto;
      }

      .product-copy {
        min-width: 0;
      }

      .product-copy strong,
      .product-copy span {
        display: block;
      }

      .product-copy strong {
        color: #111;
        font-size: 14px;
        line-height: 1.2;
        font-weight: 800;
        white-space: nowrap;
      }

      .product-copy span {
        margin-top: 3px;
        color: #80807a;
        font-size: 11px;
        line-height: 1.2;
      }

      .uninstall-hero h1 {
        max-width: 660px;
        margin: 0 auto;
        color: #111;
        font-size: clamp(30px, 5vw, 46px);
        line-height: 1.04;
        letter-spacing: -0.045em;
        font-weight: 860;
        text-wrap: balance;
      }

      .uninstall-intro {
        max-width: 530px;
        margin: 14px auto 0;
        color: #686863;
        font-size: 16px;
        line-height: 1.55;
        text-wrap: balance;
      }

      .survey-panel {
        margin-top: 30px;
        padding: 24px;
        border: 1px solid #dfdfda;
        border-radius: 20px;
        background: #fff;
        box-shadow:
          0 24px 70px rgba(17, 17, 17, 0.07),
          0 2px 8px rgba(17, 17, 17, 0.035);
      }

      .feedback-form {
        display: block;
      }

      .feedback-form[hidden],
      .feedback-done[hidden],
      .detail-wrap[hidden] {
        display: none !important;
      }

      .reason-group {
        margin: 0;
        padding: 0;
        border: 0;
      }

      .reason-group legend {
        width: 100%;
        margin: 0 0 13px;
        padding: 0;
        color: #111;
        font-size: 13px;
        line-height: 1.35;
        font-weight: 800;
      }

      .reason-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .reason-card {
        position: relative;
        min-width: 0;
        cursor: pointer;
      }

      .reason-card input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
      }

      .reason-card span {
        min-height: 58px;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 12px 44px 12px 14px;
        border: 1px solid #deded9;
        border-radius: 13px;
        background: #fff;
        color: #242421;
        font-size: 14px;
        line-height: 1.3;
        font-weight: 680;
        transition:
          border-color 0.16s ease,
          background-color 0.16s ease,
          box-shadow 0.16s ease,
          transform 0.16s ease;
      }

      .reason-card span::before {
        content: "";
        width: 8px;
        height: 8px;
        flex: 0 0 auto;
        border-radius: 999px;
        background: #c7c7c1;
        transition: background-color 0.16s ease, transform 0.16s ease;
      }

      .reason-card span::after {
        content: "";
        position: absolute;
        top: 50%;
        right: 15px;
        width: 18px;
        height: 18px;
        border: 1px solid #d6d6d1;
        border-radius: 999px;
        transform: translateY(-50%);
        background: #fff;
        transition: border-color 0.16s ease, background-color 0.16s ease;
      }

      .reason-card:hover span {
        border-color: #bdbdb7;
        background: #fbfbfa;
        transform: translateY(-1px);
      }

      .reason-card input:focus-visible + span {
        outline: 3px solid rgba(230, 0, 35, 0.16);
        outline-offset: 2px;
      }

      .reason-card input:checked + span {
        border-color: #e60023;
        background: #fff6f7;
        box-shadow: 0 0 0 1px rgba(230, 0, 35, 0.04);
      }

      .reason-card input:checked + span::before {
        background: #e60023;
        transform: scale(1.12);
      }

      .reason-card input:checked + span::after {
        border-color: #e60023;
        background:
          radial-gradient(circle at center, #fff 0 3px, transparent 3.5px),
          #e60023;
      }

      .detail-wrap {
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid #ecece8;
        animation: detail-in 0.2s ease both;
      }

      @keyframes detail-in {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .detail-label {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 8px;
      }

      .detail-label strong {
        color: #111;
        font-size: 13px;
        font-weight: 800;
      }

      .detail-label small {
        color: #8b8b85;
        font-size: 11px;
        font-weight: 650;
      }

      .feedback-textarea {
        width: 100%;
        min-height: 90px;
        resize: vertical;
        padding: 12px 13px;
        border: 1px solid #d8d8d3;
        border-radius: 12px;
        background: #fbfbfa;
        color: #171715;
        font: inherit;
        font-size: 15px;
        line-height: 1.45;
        transition: border-color 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease;
      }

      .feedback-textarea::placeholder {
        color: #9a9a94;
      }

      .feedback-textarea:focus {
        outline: none;
        border-color: #999993;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.06);
      }

      .uninstall-actions {
        margin-top: 18px;
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .uninstall-send {
        min-height: 48px;
        flex: 1 1 auto;
        border: 0;
        border-radius: 11px;
        padding: 0 22px;
        background: #e60023;
        color: #fff;
        font: inherit;
        font-size: 14px;
        font-weight: 820;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(230, 0, 35, 0.16);
        transition:
          transform 0.16s ease,
          background-color 0.16s ease,
          box-shadow 0.16s ease,
          opacity 0.16s ease;
      }

      .uninstall-send:hover:not(:disabled) {
        background: #d50020;
        transform: translateY(-1px);
        box-shadow: 0 9px 22px rgba(230, 0, 35, 0.2);
      }

      .uninstall-send:active:not(:disabled) {
        transform: translateY(0);
      }

      .uninstall-send:focus-visible {
        outline: 3px solid rgba(230, 0, 35, 0.18);
        outline-offset: 3px;
      }

      .uninstall-send:disabled {
        background: #d9d9d4;
        color: #8d8d87;
        box-shadow: none;
        cursor: not-allowed;
      }

      .uninstall-skip {
        flex: 0 0 auto;
        border: 0;
        background: transparent;
        color: #74746f;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
      }

      .uninstall-skip:hover {
        color: #111;
        text-decoration: underline;
      }

      .privacy-note {
        margin: 13px 0 0;
        color: #989892;
        font-size: 11px;
        line-height: 1.45;
        text-align: center;
      }

      .feedback-done {
        min-height: 330px;
        display: grid;
        place-items: center;
        text-align: center;
        padding: 28px 18px;
      }

      .done-inner {
        max-width: 470px;
      }

      .done-mark {
        width: 58px;
        height: 58px;
        margin: 0 auto 18px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        background: #111;
        color: #fff;
        font-size: 27px;
        line-height: 1;
        font-weight: 900;
      }

      .feedback-done h2 {
        margin: 0;
        color: #111;
        font-size: clamp(26px, 4vw, 34px);
        line-height: 1.08;
        letter-spacing: -0.035em;
      }

      .feedback-done p {
        max-width: 430px;
        margin: 11px auto 0;
        color: #6f6f69;
        font-size: 15px;
        line-height: 1.5;
      }

      .reinstall-link {
        width: fit-content;
        margin: 22px auto 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 16px;
        border: 1px solid #d8d8d3;
        border-radius: 10px;
        background: #fff;
        color: #1d1d1a;
        font-size: 13px;
        font-weight: 780;
        text-decoration: none;
        transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
      }

      .reinstall-link:hover {
        border-color: #a9a9a3;
        transform: translateY(-1px);
        box-shadow: 0 5px 14px rgba(17, 17, 17, 0.06);
      }

      .reinstall-link[hidden] {
        display: none !important;
      }

      @media (max-width: 640px) {
        .uninstall-page {
          padding: 20px 14px 32px;
        }

        .uninstall-brand {
          margin-bottom: 20px;
        }

        .product-lockup {
          margin-bottom: 17px;
        }

        .uninstall-hero h1 {
          font-size: clamp(30px, 9vw, 39px);
        }

        .uninstall-intro {
          margin-top: 11px;
          font-size: 15px;
        }

        .survey-panel {
          margin-top: 24px;
          padding: 16px;
          border-radius: 17px;
        }

        .reason-grid {
          grid-template-columns: 1fr;
          gap: 8px;
        }

        .reason-card span {
          min-height: 54px;
        }

        .uninstall-actions {
          flex-direction: column;
          gap: 12px;
        }

        .uninstall-send {
          width: 100%;
        }

        .feedback-done {
          min-height: 300px;
          padding-left: 8px;
          padding-right: 8px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .uninstall-page *,
        .uninstall-page *::before,
        .uninstall-page *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </Fragment>

  <div class="uninstall-page">
    <div class="uninstall-shell">
      <div class="uninstall-brand" aria-label="LayerPorter"><span>LayerPorter</span></div>

      <section class="uninstall-hero" aria-labelledby="un-title">
        <div class="product-lockup" id="product-lockup">
          <img id="un-product-icon" src="/pinterest-downloader/icon-128.png" alt="" width="38" height="38" />
          <div class="product-copy">
            <strong id="un-product-name">Pinterest Downloader</strong>
            <span id="un-product-meta">Chrome extension</span>
          </div>
        </div>

        <h1 id="un-title">Why did you uninstall Pinterest Downloader?</h1>
        <p class="uninstall-intro" id="un-intro">Choose the main reason. It takes a couple of seconds.</p>
      </section>

      <div class="survey-panel" id="uninstall-widget" data-state="form">
        <form id="uninstall-form" class="feedback-form" novalidate>
          <fieldset class="reason-group">
            <legend id="un-chip-legend">Choose one reason</legend>
            <div class="reason-grid">
              {reasons.map((r) => (
                <label class="reason-card">
                  <input type="radio" name="uninstall-reason" data-key={r.key} value={r.label} />
                  <span data-i18n-key={r.key}>{r.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="detail-wrap" id="detail-wrap" hidden>
            <label class="detail-label" for="uninstall-text">
              <strong id="un-detail-label">Want to add a little more?</strong>
              <small id="un-detail-optional">Optional</small>
            </label>
            <textarea
              id="uninstall-text"
              class="feedback-textarea"
              rows="3"
              placeholder="A sentence is enough."
            ></textarea>
          </div>

          <div class="uninstall-actions">
            <button type="submit" class="uninstall-send" id="uninstall-send-btn" disabled>Send feedback</button>
            <a class="uninstall-skip" href="/" id="uninstall-skip-link">Skip</a>
          </div>

          <p class="privacy-note" id="un-privacy-note">No email required. Your comment is optional.</p>
        </form>

        <div class="feedback-done" id="uninstall-done" hidden aria-live="polite">
          <div class="done-inner">
            <div class="done-mark" aria-hidden="true">✓</div>
            <h2 id="un-done-title">Thanks — that helps.</h2>
            <p id="un-done-text">We use this feedback to decide what to fix first.</p>
            <a
              class="reinstall-link"
              id="un-reinstall-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              hidden
            >Install Pinterest Downloader again</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  import { track } from '../lib/analytics';

  type Locale = 'en' | 'ru' | 'es' | 'de' | 'fr' | 'pt' | 'ja';
