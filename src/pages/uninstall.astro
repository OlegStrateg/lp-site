  function detectLocale(): Locale {
    const fromParam = new URLSearchParams(window.location.search).get('locale');
    const candidates = fromParam ? [fromParam] : Array.from(navigator.languages ?? [navigator.language]);
    for (const candidate of candidates) {
      const base = candidate.toLowerCase().split('-')[0] as Locale;
      if (SUPPORTED_LOCALES.includes(base)) return base;
    }
    return 'en';
  }

  const locale = detectLocale();
  const t = TRANSLATIONS[locale];

  document.getElementById('un-title')!.textContent = t.title;
  document.getElementById('un-intro')!.textContent = t.intro;
  document.getElementById('un-chip-legend')!.textContent = t.chipLegend;
  document.getElementById('un-text-label')!.textContent = t.textLabel;
  document.getElementById('uninstall-send-btn')!.textContent = t.send;
  document.getElementById('uninstall-skip-link')!.textContent = t.skip;
  document.getElementById('un-done-title')!.textContent = t.doneTitle;
  document.getElementById('un-done-text')!.textContent = t.doneText;
  document.getElementById('un-reinstall-link')!.textContent = t.reinstallLink;
  {
    const reinstallEl = document.getElementById('un-reinstall')!;
    reinstallEl.firstChild!.textContent = t.reinstallPrefix;
  }
  {
    const emailEl = document.getElementById('un-email-fineprint')!;
    emailEl.firstChild!.textContent = t.emailPrefix;
  }
  document.querySelectorAll<HTMLElement>('.chip span[data-i18n-key]').forEach((span) => {
    const key = span.dataset.i18nKey!;
    span.textContent = t.reasons[key] ?? span.textContent ?? '';
  });

  const params = new URLSearchParams(window.location.search);
  const p = params.get('product') || 'unknown';
  const v = params.get('v') || '';

  track('un_view', { p, v, locale });

  const widget = document.getElementById('uninstall-widget')!;
  const form = document.getElementById('uninstall-form') as HTMLFormElement;
  const textEl = document.getElementById('uninstall-text') as HTMLTextAreaElement;
  const doneEl = document.getElementById('uninstall-done')!;
  const skipLink = document.getElementById('uninstall-skip-link')!;
  const chipInputs = document.querySelectorAll<HTMLInputElement>('.chip input[type="checkbox"]');
  const winBackEl = document.getElementById('un-winback')!;

  textEl.placeholder = t.textPlaceholder;
  const DEFAULT_PLACEHOLDER = t.textPlaceholder;

  function postFeedback(payload: Record<string, unknown>) {
    fetch('/api/feedback', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
      keepalive: true,
    }).catch(() => {
      /* Best-effort only — a failed beacon must never block the uninstall UI. */
    });
  }

  // Which win-back copy fits a reason: bug-shaped reasons get the "sorry,
  // help us fix it" tone, "found something else" gets a no-guilt goodbye,
  // everything else gets the generic honest-feedback line. No discounts or
  // perks are offered anywhere here — none exist, so none are invented.
  const WIN_BACK_VARIANT: Record<string, 'bug' | 'alt'> = {
    capture: 'bug',
    'slow-crash': 'bug',
    'found-alternative': 'alt',
  };

  function updateWinBack() {
    const checked = Array.from(chipInputs).filter((i) => i.checked).map((i) => i.dataset.key ?? '');
    if (checked.length === 0) {
      winBackEl.hidden = true;
      return;
    }
    const variant = checked.map((k) => WIN_BACK_VARIANT[k]).find(Boolean) ?? 'generic';
    winBackEl.textContent = t.winBack[variant];
    winBackEl.hidden = false;
  }

  chipInputs.forEach((input) => {
    input.addEventListener('change', () => {
      const key = input.dataset.key ?? 'unknown';
      if (input.checked) {
        textEl.placeholder = t.followUp[key] ?? DEFAULT_PLACEHOLDER;
      }
      updateWinBack();
      track('un_chip', { reason: key });
    });
  });

  // One push per real event, not one per click (21.07 — owner caught this
  // in the Telegram feed: a single user toggling 3 chips then hitting Send
  // produced 4 separate, unlabeled messages, indistinguishable from 4
  // different users). Chip clicks are local UI state + internal analytics
  // only; postFeedback (KV + Telegram) fires exactly once per session,
  // either on Submit or, as a fallback, once on pagehide if the user
  // picked reasons but never submitted.
  let submitted = false;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    track('un_submit');
    submitted = true;

    const selected = Array.from(chipInputs).filter((i) => i.checked).map((i) => i.value);
    const extra = textEl.value.trim();
    const parts = extra ? [...selected, extra] : selected;
    const text = parts.length > 0 ? parts.join(' | ') : '(no reason selected)';

    postFeedback({
      p,
      channel: 'chrome-ext',
      src: 'uninstall',
      type: 'uninstall',
      text,
      v,
    });

    widget.dataset.state = 'done';
    form.hidden = true;
    doneEl.hidden = false;
  });

  // Skip used to send nothing at all (owner caught this 21.07: an uninstall
  // with Skip left zero signal in Telegram — you couldn't tell it happened).
  // Now it sends one message too, distinctly labeled so it never reads as
  // real feedback — this counts the uninstall, not a reason for it.
  skipLink.addEventListener('click', () => {
    track('un_skip');
    submitted = true; // an explicit skip is a real answer, not an abandoned draft
    postFeedback({
      p,
      channel: 'chrome-ext',
      src: 'uninstall',
      type: 'uninstall_skip',
      text: '(skipped — no feedback left)',
      v,
    });
  });

  // Abandonment fallback: fires at most once, only if the user picked at
  // least one chip and never submitted or skipped. Tagged 'draft:' so it
  // reads in Telegram as a partial selection, never confusable with a real
  // Send. sendBeacon survives tab-close better than a fetch here.
  window.addEventListener('pagehide', () => {
    if (submitted) return;
    const selected = Array.from(chipInputs).filter((i) => i.checked).map((i) => i.value);
    if (selected.length === 0) return;
    submitted = true;

    const payload = JSON.stringify({
      p,
      channel: 'chrome-ext',
      src: 'uninstall',
      type: 'uninstall_partial',
      text: `draft: ${selected.join(' | ')}`,
      v,
    });
    if (navigator.sendBeacon) {
      navigator.sendBeacon('/api/feedback', new Blob([payload], { type: 'application/json' }));
    } else {
      postFeedback(JSON.parse(payload));
    }
  });
</script>
