  const PRODUCTS: Record<string, { name: string; icon: string; store: string }> = {
    pd: {
      name: 'Pinterest Downloader',
      icon: '/pinterest-downloader/icon-128.png',
      store: 'https://chromewebstore.google.com/detail/pinterest-downloader/nmpahchhmcdejmfcmkphnbhckmlhhnon?utm_source=layerporter&utm_medium=uninstall&utm_campaign=pinterest_downloader&utm_content=reinstall',
    },
  };

  function detectLocale(): Locale {
    const fromParam = new URLSearchParams(window.location.search).get('locale');
    const candidates = fromParam ? [fromParam] : Array.from(navigator.languages ?? [navigator.language]);
    for (const candidate of candidates) {
      const base = candidate.toLowerCase().split('-')[0] as Locale;
      if (SUPPORTED_LOCALES.includes(base)) return base;
    }
    return 'en';
  }

  const params = new URLSearchParams(window.location.search);
  const p = params.get('product') || 'unknown';
  const v = params.get('v') || '';
  const locale = detectLocale();
  const t = TRANSLATIONS[locale];
  const product = PRODUCTS[p] ?? {
    name: 'LayerPorter extension',
    icon: '/favicon.svg',
    store: '',
  };

  const interpolate = (value: string) => value.replaceAll('{product}', product.name);

  document.documentElement.lang = locale;
  document.title = interpolate(t.pageTitle);

  const productIcon = document.getElementById('un-product-icon') as HTMLImageElement;
  productIcon.src = product.icon;
  document.getElementById('un-product-name')!.textContent = product.name;
  document.getElementById('un-product-meta')!.textContent = v ? `${t.productMeta} · v${v}` : t.productMeta;

  document.getElementById('un-title')!.textContent = interpolate(t.title);
  document.getElementById('un-intro')!.textContent = t.intro;
  document.getElementById('un-chip-legend')!.textContent = t.chipLegend;
  document.getElementById('un-detail-label')!.textContent = t.detailLabel;
  document.getElementById('un-detail-optional')!.textContent = t.optional;
  document.getElementById('uninstall-send-btn')!.textContent = t.send;
  document.getElementById('uninstall-skip-link')!.textContent = t.skip;
  document.getElementById('un-privacy-note')!.textContent = t.privacy;
  document.getElementById('un-done-title')!.textContent = t.doneTitle;
  document.getElementById('un-done-text')!.textContent = t.doneText;

  document.querySelectorAll<HTMLElement>('.reason-card span[data-i18n-key]').forEach((span) => {
    const key = span.dataset.i18nKey!;
    span.textContent = t.reasons[key] ?? span.textContent ?? '';
  });

  const widget = document.getElementById('uninstall-widget')!;
  const form = document.getElementById('uninstall-form') as HTMLFormElement;
  const textEl = document.getElementById('uninstall-text') as HTMLTextAreaElement;
  const detailWrap = document.getElementById('detail-wrap')!;
  const doneEl = document.getElementById('uninstall-done')!;
  const sendBtn = document.getElementById('uninstall-send-btn') as HTMLButtonElement;
  const skipLink = document.getElementById('uninstall-skip-link')!;
  const reasonInputs = document.querySelectorAll<HTMLInputElement>('input[name="uninstall-reason"]');
  const reinstallLink = document.getElementById('un-reinstall-link') as HTMLAnchorElement;

  textEl.placeholder = t.detailPlaceholder;

  if (product.store) {
    reinstallLink.href = product.store;
    reinstallLink.textContent = t.reinstall;
    reinstallLink.hidden = false;
  }

  const sid = crypto.randomUUID();
  const uninstallBase = { p, sid, v, locale };

  function postUninstall(phase: 'open' | 'feedback' | 'skip' | 'partial', extra: Record<string, unknown> = {}) {
    const payload = { ...uninstallBase, phase, ...extra };
    fetch('/api/uninstall', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
      keepalive: true,
    }).catch(() => {
      /* Best-effort only — a failed beacon must never block the UI. */
    });
  }

  function selectedReason(): HTMLInputElement | undefined {
    return Array.from(reasonInputs).find((input) => input.checked);
  }

  track('un_view', { p, v, locale });
  postUninstall('open');

  reasonInputs.forEach((input) => {
    input.addEventListener('change', () => {
      const key = input.dataset.key ?? 'other';
      detailWrap.hidden = false;
      textEl.placeholder = t.followUp[key] ?? t.detailPlaceholder;
      sendBtn.disabled = false;
      track('un_chip', { reason: key });
    });
  });

  let submitted = false;

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const selected = selectedReason();
    if (!selected) return;

    const reasonKey = selected.dataset.key ?? '';
    const comment = textEl.value.trim();

    track('un_submit');
    submitted = true;
    postUninstall('feedback', { reasonKeys: reasonKey ? [reasonKey] : [], comment });

    widget.dataset.state = 'done';
    form.hidden = true;
    doneEl.hidden = false;
  });

  skipLink.addEventListener('click', () => {
    track('un_skip');
    submitted = true;
    postUninstall('skip');
  });

  window.addEventListener('pagehide', () => {
    if (submitted) return;
    const selected = selectedReason();
    if (!selected) return;

    submitted = true;
    const reasonKey = selected.dataset.key ?? '';
    const payload = JSON.stringify({
      ...uninstallBase,
      phase: 'partial',
      reasonKeys: reasonKey ? [reasonKey] : [],
      comment: textEl.value.trim(),
    });

    if (navigator.sendBeacon) {
      navigator.sendBeacon('/api/uninstall', new Blob([payload], { type: 'application/json' }));
    } else {
      postUninstall('partial', {
        reasonKeys: reasonKey ? [reasonKey] : [],
        comment: textEl.value.trim(),
      });
    }
  });
</script>
