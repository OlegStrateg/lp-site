---
// Uninstall-survey target for the browser extensions' chrome.runtime.setUninstallURL.
// Deliberately noindex: it is a destination page, not a search landing.
//
// Redesigned 20.07: chips replace the old mailto-per-reason links. Each chip
// click fires its own fire-and-forget POST to /api/feedback (so a reason is
// captured even if the visitor never hits Send), and Send posts the full
// aggregate. Both are best-effort — this funnel never blocks on the network
// (the visitor has already uninstalled; the UI shouldn't make that worse).
//
// popup-cro pass (04.08): win-back copy (reassurance, never guilt-tripping)
// keyed off the selected reason, plus a placeholder reinstall link — real
// Chrome Web Store URL doesn't exist yet, filled in once the extension ships.
// i18n is client-side text-swap (reason keys stay in English for KV/Telegram,
// only the visible copy changes) — the static build has no per-request
// locale, so <html lang> stays "en" site-wide; only .fbx text is translated.
import PageLayout from '../layouts/PageLayout.astro';

const reasons = [
  { key: 'capture', label: "Didn't capture the page correctly" },
  { key: 'missing-feature', label: 'Missing a feature I needed' },
  { key: 'slow-crash', label: 'Too slow, or it crashed' },
  { key: 'found-alternative', label: 'Found something that fit better' },
  { key: 'unsure-how', label: "Wasn't sure how to use it" },
  { key: 'trying-out', label: 'Just trying it out, not a permanent no' },
  { key: 'privacy', label: 'Privacy or permissions concern' },
  { key: 'other', label: 'Other' },
];
---

<PageLayout
  title="Sorry to see you go — LayerPorter"
  description="Tell us in ten seconds why you removed the extension. No email, nothing saved to an account."
  canonicalPath="/uninstall/"
  robots="noindex, nofollow"
>
  <div class="fbx">
  <h1 id="un-title">Before you go</h1>
  <p class="answer-first" id="un-intro">
    This takes ten seconds, no email, nothing saved to an account. It just tells us what to fix.
  </p>

  <div class="feedback-card" id="uninstall-widget" data-state="form">
    <form id="uninstall-form" class="feedback-form" novalidate>
      <fieldset class="chip-group">
        <legend class="field-label" id="un-chip-legend">What made you uninstall?</legend>
        {reasons.map((r) => (
          <label class="chip">
            <input type="checkbox" data-key={r.key} value={r.label} />
            <span data-i18n-key={r.key}>{r.label}</span>
          </label>
        ))}
      </fieldset>

      <div class="win-back-note" id="un-winback" hidden></div>

      <label class="field-label" for="uninstall-text" id="un-text-label">Anything else?</label>
      <textarea
        id="uninstall-text"
        class="feedback-textarea"
        placeholder="Optional — a sentence is enough."
      ></textarea>

      <div class="uninstall-actions">
        <button type="submit" class="btn" id="uninstall-send-btn">Send</button>
        <a class="uninstall-skip" href="/" id="uninstall-skip-link">Skip</a>
      </div>
    </form>

    <div class="feedback-done" id="uninstall-done" hidden>
      <h2 id="un-done-title">Thanks for the two seconds.</h2>
      <p id="un-done-text">Your answer helps us fix what's actually broken.</p>
      <p class="reinstall-note" id="un-reinstall">
        Change your mind? <!-- TODO(owner): swap href for the real Chrome Web Store URL once published --><a
          href="#"
          id="un-reinstall-link"
          data-pending="chrome-store-url"
          rel="noopener"
        >reinstall it here</a>.
      </p>
    </div>
  </div>

  <p class="feedback-fineprint" id="un-email-fineprint">
    Prefer email? <a href="mailto:hello@layerporter.com">hello@layerporter.com</a>
  </p>
  </div>
</PageLayout>

