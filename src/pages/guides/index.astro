---
// Hub page for /guides/{slug}/ articles. Exists mainly so the BreadcrumbList
// JSON-LD on every guide article (ArticleLayout.astro, position 2 item:
// `${site}/guides/`) points at a real 200 page instead of a 404 — plus it's
// a genuinely useful index for a visitor who lands here directly.
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('articles', (e) => e.data.section === 'guides')).sort((a, b) =>
  a.data.h1.localeCompare(b.data.h1),
);
---

<PageLayout
  title="Guides — LayerPorter"
  description="Task-oriented guides for working with layered files, exports, and design-tool handoffs — from LayerPorter."
  canonicalPath="/guides/"
>
  <div class="fbx hub-idx">
    <h1>Guides</h1>
    <p class="answer-first">
      Task-oriented guides for working with layered files, exports, and moving designs between
      tools.
    </p>

    <div class="tool-cards">
      {entries.map((e) => (
        <a class="tool-card" href={`/guides/${e.data.slug}/`}>
          <h3>{e.data.h1}</h3>
          <p>{e.data.description}</p>
        </a>
      ))}
    </div>

    <p class="hub-cross">Looking for the tools themselves? <a href="/convert/">Browse all converters →</a></p>
  </div>
</PageLayout>
