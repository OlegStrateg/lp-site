  .download-compare { padding:110px 0; border-bottom:1px solid var(--rule); }
  .download-compare-grid { display:grid; grid-template-columns:.82fr 1.18fr; gap:90px; }
  .download-compare-grid>div>p { max-width:42ch; margin-top:30px; }
  .download-comparison { border-top:2px solid var(--ink); }
  .download-comparison>div { display:grid; grid-template-columns:1.35fr .85fr .85fr; border-bottom:1px solid var(--rule); }
  .download-comparison span { padding:18px 14px; font-size:13px; }
  .download-comparison span+span { border-left:1px solid var(--rule); }
  .download-comparison .is-head span { font-size:10px; font-weight:850; letter-spacing:.1em; text-transform:uppercase; }
  .download-comparison b { color:var(--signal); }

  .download-trust { position:relative; display:grid; grid-template-columns:180px 1fr .72fr; gap:60px; align-items:center; padding:100px 0; border-bottom:1px solid var(--rule); }
  .download-trust-mark { display:grid; width:160px; height:160px; place-items:center; border:1px solid var(--ink); border-radius:50%; color:var(--signal); font-size:28px; font-weight:950; line-height:.8; text-align:center; transform:rotate(-8deg); }
  .download-trust h2 { margin:0; font-size:clamp(44px,5.5vw,78px); line-height:.92; letter-spacing:-.06em; }
  .download-trust-copy { color:#5d584f; font-size:16px; line-height:1.55; }

  .download-faq { padding:110px 0; }
  .download-faq-grid { display:grid; grid-template-columns:.72fr 1.28fr; gap:100px; }
  .download-faq-grid>div:first-child>p { max-width:34ch; margin-top:28px; color:#5d584f; }
  .download-faq-list { border-top:2px solid var(--ink); }
  .download-faq details { border-bottom:1px solid var(--rule); }
  .download-faq summary { display:grid; grid-template-columns:38px 1fr 28px; gap:16px; align-items:center; padding:24px 0; cursor:pointer; list-style:none; font-size:18px; font-weight:750; }
  .download-faq summary::-webkit-details-marker { display:none; }
  .download-faq summary span { color:#817a70; font-size:10px; letter-spacing:.1em; }
  .download-faq summary i { font-style:normal; font-size:24px; transition:transform 180ms ease-out; }
  .download-faq details[open] summary i { transform:rotate(45deg); }
  .download-faq details p { max-width:65ch; margin:0 0 24px 54px; color:#5d584f; line-height:1.6; }

  .download-final { width:calc(100% + 48px); margin-left:-24px; padding:100px 24px 110px; background:var(--signal); color:#fff; text-align:center; }
