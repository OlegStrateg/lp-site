---
import PageLayout from '../../layouts/PageLayout.astro';
import { extensions } from '../../data/extensions';

const downloader = extensions.find((e) => e.id === 'picture-converter');
if (!downloader?.storeUrl) {
  throw new Error('Downloader store URL is missing');
}

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://layerporter.com';
const pageUrl = `${site}/extensions/picture-converter/`;
const storeUrl = downloader.storeUrl.replace('utm_campaign=extensions-page', 'utm_campaign=downloader-page');

const faqItems = [
  {
    question: 'What is Downloader for Chrome?',
    answer: 'Downloader is a Chrome extension for saving Pinterest images, GIFs, and videos. It adds a direct download workflow to the page so you can save one Pin or collect media from a board without opening a separate downloader site.',
  },
  {
    question: 'Can Downloader save Pinterest videos and GIFs?',
    answer: 'Yes. Downloader supports Pinterest images, animated GIFs, and videos when the media is available on the Pin you are viewing.',
  },
  {
    question: 'Can I download a whole Pinterest board?',
    answer: 'Yes. Use the board workflow to collect available media and export the selection together as a ZIP instead of saving every Pin manually.',
  },
  {
    question: 'Do I need a LayerPorter account?',
    answer: 'No. The extension does not require a LayerPorter account. Access to private or restricted Pinterest content still depends on the permissions of your Pinterest session.',
  },
  {
    question: 'Does Downloader add watermarks?',
    answer: 'No. Downloader saves the available media file without adding a LayerPorter watermark.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': site + '/#org',
      name: 'LayerPorter',
      url: site + '/',
    },
    {
      '@type': 'WebSite',
      '@id': site + '/#website',
      name: 'LayerPorter',
      url: site + '/',
      publisher: { '@id': site + '/#org' },
    },
    {
      '@type': 'WebPage',
      '@id': pageUrl + '#webpage',
      name: 'Downloader for Chrome',
      description: 'Download Pinterest images, GIFs, and videos from Chrome. Save a single Pin or collect a whole board as a ZIP.',
      url: pageUrl,
      isPartOf: { '@id': site + '/#website' },
      mainEntity: { '@id': pageUrl + '#software' },
      publisher: { '@id': site + '/#org' },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': pageUrl + '#software',
      name: 'Downloader',
      applicationCategory: 'BrowserApplication',
      operatingSystem: 'Chrome',
      description: 'Chrome extension for downloading Pinterest images, GIFs, and videos, including single Pins and board collections.',
      url: pageUrl,
      installUrl: storeUrl,
      isAccessibleForFree: true,
      featureList: [
        'Download Pinterest images',
        'Download Pinterest GIFs and videos',
        'Save a single Pin',
        'Collect a Pinterest board',
        'Export multiple files as ZIP',
      ],
      publisher: { '@id': site + '/#org' },
    },
    {
      '@type': 'FAQPage',
      '@id': pageUrl + '#faq',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<PageLayout
  title="Downloader for Chrome — Save Pinterest Images, GIFs & Videos"
  description="Download Pinterest images, GIFs, and videos in Chrome. Save a single Pin or collect a whole board as a ZIP with Downloader."
  canonicalPath="/extensions/picture-converter/"
  ogImage={`${site}/og/home.png`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <div class="download-landing">
    <p class="breadcrumb download-breadcrumb"><a href="/extensions/">Extensions</a><span aria-hidden="true">/</span><span>Downloader</span></p>

    <section class="download-hero" aria-labelledby="download-title">
      <div class="download-hero-copy">
        <p class="download-kicker"><span aria-hidden="true">↓</span> Chrome extension · Free</p>
        <h1 id="download-title">Download what you came for.</h1>
        <p class="download-lede">
          Downloader saves <strong>Pinterest images, GIFs, and videos</strong> from the page you are viewing — one Pin or a whole board, without the copy-paste detour.
        </p>
        <div class="download-actions">
          <a class="download-cta" href={storeUrl} rel="noopener">
            <span>Add Downloader to Chrome</span>
            <span class="download-cta-arrow" aria-hidden="true">↗</span>
          </a>
          <p>No account. No watermark. Your files stay yours.</p>
        </div>
        <ul class="download-proof" aria-label="Downloader highlights">
          <li>Single Pins</li>
          <li>Whole boards</li>
          <li>ZIP exports</li>
        </ul>
      </div>

      <div class="download-stage" aria-label="Downloader saving media from a Pinterest board">
        <div class="download-browser">
          <div class="download-browser-bar">
            <span></span><span></span><span></span>
            <div class="download-address">pinterest.com / ideas / studio</div>
            <div class="download-mark" aria-hidden="true">↓</div>
          </div>
          <div class="download-browser-body">
            <div class="download-board">
              <div class="download-pin pin-tall"><span>Editorial</span></div>
              <div class="download-pin pin-warm"><span>Objects</span></div>
              <div class="download-pin pin-dark"><span>Type study</span></div>
              <div class="download-pin pin-blue">
                <span>Campaign</span>
                <button type="button" tabindex="-1">Save <b>↓</b></button>
              </div>
              <div class="download-pin pin-paper"><span>Archive</span></div>
              <div class="download-pin pin-tall pin-red"><span>Posters</span></div>
            </div>
            <aside class="download-tray" aria-label="Download queue">
              <div class="download-tray-head"><strong>Downloads</strong><span>3 files</span></div>
              <div class="download-file"><i>JPG</i><span>campaign-04</span><b>100%</b></div>
              <div class="download-file"><i>GIF</i><span>motion-study</span><b>100%</b></div>
              <div class="download-file"><i>MP4</i><span>cut-07</span><b>72%</b></div>
              <div class="download-progress"><span></span></div>
              <button type="button" tabindex="-1">Download board as ZIP</button>
            </aside>
          </div>
        </div>
        <div class="download-float-file" aria-hidden="true"><b>JPG</b><span>campaign-04.jpg</span><i>↓</i></div>
      </div>
    </section>

    <div class="download-marquee" aria-hidden="true">
      <div>
        <span>Save one Pin</span><i>↓</i><span>Collect a board</span><i>↓</i><span>Export a ZIP</span><i>↓</i>
        <span>Save one Pin</span><i>↓</i><span>Collect a board</span><i>↓</i><span>Export a ZIP</span><i>↓</i>
      </div>
    </div>

    <section class="download-section download-intro" aria-labelledby="direct-heading">
      <div class="download-section-index">02 / Direct by design</div>
      <div class="download-intro-copy" data-reveal>
        <h2 id="direct-heading">Less tab-switching.<br />More keeping.</h2>
        <p>Downloader puts the save action where the media already is. No hunt for a third-party form, no repeated copy and paste, no mystery file at the end.</p>
      </div>

      <div class="download-modes">
        <article data-reveal>
          <div class="download-mode-number">01</div>
          <div>
            <p class="download-mode-label">On the Pin</p>
            <h3>Hover. Save. Done.</h3>
            <p>Open a Pin and download the image, GIF, or video from the page you are already viewing.</p>
          </div>
          <div class="download-mode-demo demo-hover" aria-hidden="true">
            <span class="demo-media">PIN</span><b>Download ↓</b>
          </div>
        </article>
        <article data-reveal>
          <div class="download-mode-number">02</div>
          <div>
            <p class="download-mode-label">From a link</p>
            <h3>Paste the URL once.</h3>
            <p>Use a Pin link when you want a precise, single-file workflow without digging through page menus.</p>
          </div>
          <div class="download-mode-demo demo-link" aria-hidden="true">
            <span>pinterest.com/pin/...</span><b>→</b>
          </div>
        </article>
        <article data-reveal>
          <div class="download-mode-number">03</div>
          <div>
            <p class="download-mode-label">Across a board</p>
            <h3>Collect first. ZIP once.</h3>
            <p>Select the available media you need and export the batch together instead of saving Pins one by one.</p>
          </div>
          <div class="download-mode-demo demo-stack" aria-hidden="true">
            <i>JPG</i><i>GIF</i><i>MP4</i><b>ZIP ↓</b>
          </div>
        </article>
      </div>
    </section>

    <section class="download-process" aria-labelledby="process-heading">
      <div class="download-section-index">03 / The short route</div>
      <div class="download-process-head" data-reveal>
        <h2 id="process-heading">The file is three moves away.</h2>
        <p>Install once. Then use Downloader directly from Pinterest whenever something is worth keeping.</p>
      </div>
      <ol class="download-steps">
        <li data-reveal><span>1</span><strong>Open Pinterest</strong><p>Go to a Pin or board containing the media you want.</p></li>
        <li data-reveal><span>2</span><strong>Choose what to save</strong><p>Use the direct action for one file or collect a batch from the board.</p></li>
        <li data-reveal><span>3</span><strong>Download</strong><p>Save the original media type or export the selected batch as a ZIP.</p></li>
      </ol>
      <div class="download-keyboard" data-reveal aria-hidden="true">
        <span class="key-command">PIN</span><i>→</i><span class="key-command is-hot">DOWNLOAD</span><i>→</i><span class="key-file">FILE ↓</span>
      </div>
    </section>

    <section class="download-compare" aria-labelledby="compare-heading">
      <div class="download-section-index">04 / Manual vs direct</div>
      <div class="download-compare-grid">
        <div data-reveal>
          <h2 id="compare-heading">Browser save is fine.<br />Until it isn’t.</h2>
          <p>Downloader is for the cases where the image is nested, the Pin contains motion, or an entire board needs to leave Pinterest with you.</p>
        </div>
        <div class="download-comparison" role="table" aria-label="Browser save compared with Downloader" data-reveal>
          <div role="row" class="is-head"><span role="columnheader">Task</span><span role="columnheader">Browser</span><span role="columnheader">Downloader</span></div>
          <div role="row"><span role="cell">Save a visible image</span><span role="cell">Sometimes</span><span role="cell"><b>One action</b></span></div>
          <div role="row"><span role="cell">Save a Pinterest video</span><span role="cell">No direct action</span><span role="cell"><b>Supported</b></span></div>
          <div role="row"><span role="cell">Collect a board</span><span role="cell">One by one</span><span role="cell"><b>Batch + ZIP</b></span></div>
          <div role="row"><span role="cell">Add a watermark</span><span role="cell">No</span><span role="cell"><b>No</b></span></div>
        </div>
      </div>
    </section>

    <section class="download-trust" aria-labelledby="trust-heading">
      <div class="download-trust-mark" aria-hidden="true">NO<br />FUSS</div>
      <div data-reveal>
        <p class="download-mode-label">Your workflow, not ours</p>
        <h2 id="trust-heading">No account.<br />No watermark.<br />You stay in control.</h2>
      </div>
      <div class="download-trust-copy" data-reveal>
        <p>Downloader acts when you ask it to. It does not add a LayerPorter account step or stamp our brand onto the saved file.</p>
        <p>Private and restricted Pinterest content remains governed by the access available in your own Pinterest session.</p>
      </div>
    </section>

    <section class="download-faq" id="faq" aria-labelledby="faq-heading">
      <div class="download-section-index">05 / Clear answers</div>
      <div class="download-faq-grid">
        <div>
          <h2 id="faq-heading">Before you add it.</h2>
          <p>Short answers for people. Specific enough to be useful, clear enough to quote.</p>
        </div>
        <div class="download-faq-list">
          {faqItems.map((item, index) => (
            <details data-reveal open={index === 0}>
              <summary><span>{String(index + 1).padStart(2, '0')}</span>{item.question}<i aria-hidden="true">+</i></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="download-final" aria-labelledby="final-heading">
      <p class="download-kicker"><span aria-hidden="true">↓</span> Downloader for Chrome</p>
      <h2 id="final-heading">Keep the idea.<br />Skip the chore.</h2>
      <a class="download-cta download-cta-light" href={storeUrl} rel="noopener">
        <span>Add Downloader to Chrome — free</span>
        <span class="download-cta-arrow" aria-hidden="true">↗</span>
      </a>
      <p>Images · GIFs · Videos · Boards · ZIP</p>
    </section>
  </div>
</PageLayout>
<style>
  :global(.page-prose) { max-width: none; width: 100%; }
  :global(main.wrap) { max-width: 1280px; }
  .download-landing { --ink:#12110f; --paper:#f2eee5; --signal:#ff4d00; --rule:rgba(18,17,15,.2); color:var(--ink); }
  .download-breadcrumb { margin-bottom:0; }
  .download-hero { position:relative; display:grid; grid-template-columns:minmax(0,.83fr) minmax(560px,1.17fr); gap:clamp(36px,6vw,88px); align-items:center; min-height:760px; padding:clamp(54px,8vw,104px) 0 84px; border-bottom:1px solid var(--rule); }
  .download-hero::before { content:'01'; position:absolute; top:28px; right:0; font:700 12px/1 var(--font-sans); letter-spacing:.16em; }
  .download-kicker { display:inline-flex; align-items:center; gap:10px; margin:0 0 30px; font-size:12px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
  .download-kicker span { display:grid; width:28px; height:28px; place-items:center; border-radius:50%; background:var(--signal); color:#fff; font-size:16px; }
  .download-hero h1 { max-width:9ch; margin:0; font-size:clamp(58px,7.4vw,112px); line-height:.86; letter-spacing:-.075em; text-wrap:balance; }
  .download-lede { max-width:51ch; margin:34px 0 0; font-size:clamp(18px,1.7vw,23px); line-height:1.42; letter-spacing:-.02em; }
  .download-actions { display:flex; align-items:center; gap:18px; margin-top:34px; }
  .download-actions p { max-width:22ch; margin:0; color:#5d584f; font-size:12px; line-height:1.45; }
  .download-cta { display:inline-flex; min-height:58px; align-items:center; gap:22px; padding:0 10px 0 22px; border:1px solid var(--ink); background:var(--ink); color:#fff; font-size:15px; font-weight:750; text-decoration:none; transition:transform 180ms ease-out,background 180ms ease-out; }
  .download-cta:hover { background:var(--signal); transform:translateY(-2px); }
  .download-cta-arrow { display:grid; width:40px; height:40px; place-items:center; border-left:1px solid rgba(255,255,255,.24); font-size:18px; }
  .download-proof { display:flex; flex-wrap:wrap; gap:0; margin:38px 0 0; padding:0; list-style:none; border-top:1px solid var(--rule); }
  .download-proof li { padding:12px 18px 0 0; margin-right:18px; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .download-stage { position:relative; perspective:1600px; }
  .download-browser { overflow:hidden; border:1px solid #191816; border-radius:18px; background:#d8d0c2; box-shadow:0 40px 80px rgba(27,22,15,.18); transform:rotateY(-5deg) rotateX(2deg); transform-origin:center; animation:stage-in 900ms cubic-bezier(.16,1,.3,1) both; }
  .download-browser-bar { display:flex; height:48px; align-items:center; gap:7px; padding:0 12px; border-bottom:1px solid rgba(0,0,0,.16); background:#ece8df; }
  .download-browser-bar>span { width:8px; height:8px; border-radius:50%; background:#aaa398; }
  .download-address { flex:1; margin-left:8px; padding:7px 12px; background:#fff; color:#777066; font-size:10px; }
  .download-mark { display:grid; width:30px; height:30px; place-items:center; background:var(--signal); color:#fff; font-weight:900; }
  .download-browser-body { display:grid; grid-template-columns:1fr 196px; min-height:470px; }
  .download-board { display:grid; grid-template-columns:repeat(3,1fr); grid-auto-rows:130px; gap:9px; padding:18px; background:#f7f4ed; }
  .download-pin { position:relative; display:flex; align-items:flex-end; overflow:hidden; padding:12px; background:#c9beb0; color:#fff; font-size:10px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .download-pin::before { content:''; position:absolute; inset:16% 22%; border:1px solid currentColor; border-radius:50%; opacity:.38; transform:rotate(-18deg); }
  .download-pin span,.download-pin button { position:relative; z-index:1; }
  .pin-tall { grid-row:span 2; background:#22201d; } .pin-warm { background:#bc6f42; } .pin-dark { background:#737067; } .pin-blue { grid-column:span 2; background:#3658b9; } .pin-paper { background:#c9bfae; color:#28241f; } .pin-red { background:#b93f2d; }
  .download-pin button { position:absolute; top:10px; right:10px; display:flex; align-items:center; gap:10px; padding:8px 10px; border:0; background:var(--signal); color:#fff; font:800 10px/1 var(--font-sans); text-transform:uppercase; }
  .download-tray { padding:18px 14px; border-left:1px solid rgba(0,0,0,.18); background:#171614; color:#fff; }
  .download-tray-head { display:flex; justify-content:space-between; margin-bottom:24px; font-size:11px; } .download-tray-head span { color:#878177; }
  .download-file { display:grid; grid-template-columns:32px 1fr auto; gap:8px; align-items:center; padding:12px 0; border-top:1px solid rgba(255,255,255,.12); font-size:9px; }
  .download-file i { display:grid; width:28px; height:28px; place-items:center; background:#2b2925; color:#aaa49a; font-style:normal; font-weight:800; }
  .download-file b { color:#8d877d; font-size:8px; } .download-progress { height:2px; background:#393631; }
  .download-progress span { display:block; width:72%; height:100%; background:var(--signal); animation:progress 2.4s cubic-bezier(.16,1,.3,1) infinite alternate; }
  .download-tray button { width:100%; margin-top:24px; padding:12px 8px; border:1px solid rgba(255,255,255,.25); background:transparent; color:#fff; font:700 9px/1 var(--font-sans); text-transform:uppercase; }
  .download-float-file { position:absolute; right:-22px; bottom:34px; display:grid; grid-template-columns:42px 1fr 24px; gap:10px; align-items:center; width:228px; padding:11px; border:1px solid var(--ink); background:var(--paper); box-shadow:0 18px 36px rgba(0,0,0,.16); animation:file-float 3.8s ease-in-out infinite; }
  .download-float-file b { padding:10px 7px; background:var(--signal); color:#fff; font-size:10px; text-align:center; } .download-float-file span { font-size:10px; font-weight:750; } .download-float-file i { font-style:normal; font-size:18px; }
  @keyframes stage-in { from { opacity:0; transform:translateY(36px) rotateY(-9deg) rotateX(4deg); } }
  @keyframes file-float { 0%,100% { transform:translate3d(0,0,0) rotate(-1deg); } 50% { transform:translate3d(-5px,-10px,0) rotate(1deg); } }
  @keyframes progress { from { transform:scaleX(.24); transform-origin:left; } to { transform:scaleX(1); transform-origin:left; } }
  @media(max-width:1040px){ .download-hero{grid-template-columns:1fr;min-height:auto}.download-hero-copy{max-width:760px}.download-stage{max-width:760px} }
  @media(max-width:680px){ .download-hero{padding-top:46px}.download-hero h1{font-size:clamp(54px,18vw,76px)}.download-actions{align-items:flex-start;flex-direction:column}.download-browser{transform:none}.download-browser-body{grid-template-columns:1fr}.download-tray{display:none}.download-board{grid-auto-rows:96px;padding:10px;gap:6px}.download-float-file{right:-6px;bottom:-24px} }
  @media(prefers-reduced-motion:reduce){ .download-browser,.download-float-file,.download-progress span{animation:none}.download-cta{transition:none} }

  :global(body) { background:#f2eee5; }
  :global(body)::before { opacity:.08; }
  :global(.site-header) { background:rgba(242,238,229,.92); border-bottom-color:rgba(18,17,15,.18); }
  :global(.site-footer) { margin-top:0; background:#12110f; color:#bdb5a8; border-top:0; }
  :global(.site-footer a) { color:#f2eee5; }

  [data-reveal] { opacity:0; transform:translateY(30px); transition:opacity 700ms cubic-bezier(.16,1,.3,1),transform 700ms cubic-bezier(.16,1,.3,1); }
  [data-reveal].is-visible { opacity:1; transform:translateY(0); }

  .download-marquee { overflow:hidden; width:calc(100% + 48px); margin-left:-24px; border-block:1px solid var(--ink); background:var(--signal); color:#fff; }
  .download-marquee div { display:flex; width:max-content; align-items:center; padding:13px 0; animation:marquee 22s linear infinite; }
  .download-marquee span { padding:0 24px; font-size:12px; font-weight:850; letter-spacing:.13em; text-transform:uppercase; }
  .download-marquee i { font-style:normal; font-size:18px; }

  .download-section { padding:100px 0; border-bottom:1px solid var(--rule); }
  .download-section-index { margin-bottom:72px; font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
  .download-intro-copy { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.55fr); gap:70px; align-items:end; }
  .download-intro h2,.download-compare h2,.download-faq h2 { margin:0; font-size:clamp(48px,6.5vw,92px); line-height:.92; letter-spacing:-.065em; }
  .download-intro-copy>p,.download-compare-grid>div>p { margin:0; font-size:20px; line-height:1.5; }

  .download-modes { margin-top:90px; border-top:1px solid var(--ink); }
  .download-modes article { display:grid; grid-template-columns:72px minmax(280px,1fr) minmax(320px,.9fr); gap:30px; align-items:center; padding:32px 0; border-bottom:1px solid var(--rule); }
  .download-mode-number { font:800 11px/1 var(--font-sans); }
  .download-mode-label { margin:0 0 8px; color:#756f65; font-size:10px; font-weight:850; letter-spacing:.13em; text-transform:uppercase; }
  .download-modes h3 { margin:0; font-size:28px; letter-spacing:-.035em; }
  .download-modes article>div:nth-child(2)>p:last-child { max-width:54ch; margin:10px 0 0; color:#5d584f; }
  .download-mode-demo { position:relative; min-height:108px; overflow:hidden; border:1px solid var(--ink); background:#e7e0d4; }
  .demo-hover { display:grid; place-items:center; background:#3558b8; color:#fff; }
  .demo-hover .demo-media { font-size:42px; font-weight:900; letter-spacing:-.08em; opacity:.22; }
  .demo-hover b { position:absolute; right:12px; top:12px; padding:10px 12px; background:var(--signal); font-size:10px; text-transform:uppercase; animation:button-peek 3.4s cubic-bezier(.16,1,.3,1) infinite; }
  .demo-link { display:flex; align-items:center; justify-content:space-between; padding:0 18px; background:#fff; }
  .demo-link span { color:#777066; font-size:11px; }
  .demo-link b { display:grid; width:42px; height:42px; place-items:center; background:var(--ink); color:#fff; font-size:18px; }
  .demo-stack { display:flex; align-items:center; padding:20px; }
  .demo-stack i { display:grid; width:58px; height:66px; place-items:center; margin-right:-16px; border:1px solid var(--ink); background:#f7f3eb; font:800 10px/1 var(--font-sans); transform:rotate(-3deg); }
