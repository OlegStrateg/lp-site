  .download-final>p:last-child { margin-top:30px; font-size:10px; font-weight:850; letter-spacing:.18em; text-transform:uppercase; }

  @keyframes marquee { to { transform:translateX(-50%); } }
  @keyframes button-peek { 0%,18% { transform:translateY(-20px); opacity:0; } 28%,80% { transform:translateY(0); opacity:1; } 92%,100% { transform:translateY(10px); opacity:0; } }

  @media(max-width:900px){
    .download-intro-copy,.download-process-head,.download-compare-grid,.download-faq-grid{grid-template-columns:1fr}
    .download-modes article{grid-template-columns:48px 1fr}.download-mode-demo{grid-column:2}
    .download-process-head{gap:30px}.download-steps{grid-template-columns:1fr}.download-steps li{border-right:0;border-bottom:1px solid rgba(255,255,255,.18);padding:24px 0}.download-steps li+li{padding-left:0}.download-steps span{margin-bottom:24px}
    .download-trust{grid-template-columns:140px 1fr}.download-trust-copy{grid-column:2}
  }
  @media(max-width:620px){
    .download-section{padding:72px 0}.download-section-index{margin-bottom:48px}
    .download-modes{margin-top:60px}.download-modes article{grid-template-columns:1fr;gap:16px}.download-mode-demo{grid-column:1}
    .download-process,.download-final,.download-marquee{width:calc(100% + 32px);margin-left:-16px}.download-process,.download-final{padding-inline:16px}
    .download-process h2{font-size:58px}.download-keyboard{gap:8px;padding:20px 8px}.key-command,.key-file{padding:13px 10px;font-size:9px}
    .download-compare{padding:76px 0}.download-comparison span{padding:13px 7px;font-size:11px}
    .download-trust{grid-template-columns:1fr;gap:32px;padding:72px 0}.download-trust-mark{width:120px;height:120px}.download-trust-copy{grid-column:1}
    .download-faq{padding:76px 0}.download-faq-grid{gap:46px}.download-faq summary{font-size:16px}
  }
  @media(prefers-reduced-motion:reduce){
    [data-reveal]{opacity:1;transform:none;transition:none}.download-marquee div,.demo-hover b{animation:none}.download-faq summary i{transition:none}
  }</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealItems = Array.from(document.querySelectorAll('[data-reveal]'));

  if (reducedMotion || !('IntersectionObserver' in window)) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.14 });

    revealItems.forEach((item) => observer.observe(item));
  }

  const stage = document.querySelector('.download-stage');
  const browser = document.querySelector('.download-browser');
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  if (stage && browser && finePointer && !reducedMotion) {
    stage.addEventListener('pointermove', (event) => {
      const bounds = stage.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      browser.style.transform = 'rotateY(' + (x * 7 - 4) + 'deg) rotateX(' + (y * -5 + 2) + 'deg)';
    });
    stage.addEventListener('pointerleave', () => {
      browser.style.transform = 'rotateY(-5deg) rotateX(2deg)';
    });
  }
</script>