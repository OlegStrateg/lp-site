  .download-steps { display:grid; grid-template-columns:repeat(3,1fr); gap:0; margin:90px 0 0; padding:0; list-style:none; border-top:1px solid rgba(255,255,255,.25); }
  .download-steps li { padding:24px 26px 0 0; border-right:1px solid rgba(255,255,255,.18); }
  .download-steps li+li { padding-left:26px; }
  .download-steps span { display:block; margin-bottom:70px; color:var(--signal); font-size:12px; font-weight:900; }
  .download-steps strong { display:block; font-size:22px; }
  .download-steps p { max-width:32ch; color:#aaa297; }
  .download-keyboard { display:flex; align-items:center; justify-content:center; gap:16px; margin-top:84px; padding:32px; border:1px solid rgba(255,255,255,.22); }
  .key-command,.key-file { padding:18px 22px; border:1px solid rgba(255,255,255,.3); font-size:12px; font-weight:900; letter-spacing:.12em; }
