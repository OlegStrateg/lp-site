---
// Hub for all LayerPorter browser extensions. Available products come first;
// future products stay secondary and never borrow claims from a different job.
import PageLayout from '../layouts/PageLayout.astro';
import { extensions } from '../data/extensions';

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://layerporter.com';
const pageUrl = `${site}/extensions/`;

// No SoftwareApplication/offers schema — there's no store listing to back an
// offer claim yet, and marking one up would be describing a product that
// doesn't exist. A plain WebPage node is the honest amount of markup here.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#org`,
      name: 'LayerPorter',
      url: `${site}/`,
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      name: 'Browser extensions',
      description: 'LayerPorter browser extensions for faster media and design workflows. Downloader is available now for Pinterest images, GIFs, videos, and board ZIP exports.',
      url: pageUrl,
      isPartOf: { '@id': `${site}/#website` },
      publisher: { '@id': `${site}/#org` },
    },
  ],
};
---

<PageLayout
  title="Browser Extensions for Files & Design — LayerPorter"
  description="LayerPorter browser extensions for faster media and design workflows. Downloader saves Pinterest images, GIFs, videos, and complete board selections."
  canonicalPath="/extensions/"
  ogImage={`${site}/og/home.png`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <h1>Browser extensions for faster file and design workflows</h1>
  <p class="answer-first">
    <strong>Downloader is available now</strong> for saving Pinterest images, GIFs, videos, and board selections in Chrome. More LayerPorter extensions are coming next for turning live websites into editable design layers.
  </p>

  <div class="extension-showcase">
    {extensions.map((e) => (
      <div class="extension-show-card" id={e.id} class:list={[{ featured: e.storeUrl !== null }]}>
        <div class="extension-show-head">
          <h2>{e.name}</h2>
          {e.storeUrl ? (
            <span class="trust-badge extension-status-badge extension-live-badge">Available now</span>
          ) : (
            <span class="trust-badge extension-status-badge">Coming to Chrome Web Store</span>
          )}
        </div>
        <p>{e.whatItDoes}</p>
        <ul class="extension-show-bullets">
          {e.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
        {e.id === 'picture-converter' && (
          <p><a class="text-link" href="/extensions/picture-converter/">See Downloader details →</a></p>
        )}
        {e.storeUrl ? (
          <a class="btn extension-install-btn btn-primary" href={e.storeUrl} rel="noopener">Add to Chrome — Free</a>
        ) : (
          <button class="btn extension-install-btn" disabled aria-disabled="true" title="Not in the Chrome Web Store yet — this button goes live with the listing">
            Add to Chrome — coming soon
          </button>
        )}
        <p class="extension-show-bridge">
          Use a LayerPorter tool now → <a href={e.bridgeHref}>{e.bridgeLabel}</a>
        </p>
      </div>
    ))}
  </div>

  <p class="extension-why-not-yet">
    <strong>More extensions coming soon:</strong> Site to Canva and PSD Export are in final polish and Chrome Web
    Store submission. This page will link to each listing as soon as it's live.
  </p>
</PageLayout>
