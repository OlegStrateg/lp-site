---
import Icon from './Icon.astro';

interface Props { toolHeading: string }
const { toolHeading } = Astro.props;
const pictureStore = 'https://chromewebstore.google.com/detail/picture-converter/oegpbmdpckfdgodnkdnoggedamfflfcl?utm_source=layerporter&utm_medium=website&utm_campaign=ptbr_psd_to_jpg&utm_content=success_offer';
---

<section aria-labelledby="tool-heading" class="tool-section">
  <h2 id="tool-heading" class="tool-heading">{toolHeading}</h2>

  <div id="converter-widget" class="converter-widget" data-state="empty" data-input="psd" data-output="jpg" role="group" aria-label="Conversor de PSD para JPG">
    <div class="dz-state" data-state-view="empty">
      <div class="dz-empty-icon"><Icon name="folder" /></div>
      <p class="dz-title">Solte um arquivo PSD — ou clique para escolher</p>
      <p class="dz-sub">O arquivo não sai desta aba.</p>
      <button type="button" class="btn" id="choose-file-btn">Escolher PSD — grátis</button>
    </div>

    <div class="dz-state" data-state-view="drag-over" hidden><p class="dz-title">Solte para converter</p></div>

    <div class="dz-state" data-state-view="processing" hidden>
      <div class="progress-track" aria-hidden="true"><div class="progress-fill"></div></div>
      <p class="dz-title">Exportando seu JPG…</p>
    </div>

    <div class="dz-state" data-state-view="success" hidden>
      <p class="dz-title">Seu JPG está pronto</p>
      <ul class="layer-preview" id="layer-preview-list"></ul>
      <a class="btn" id="download-link" download>Baixar JPG (sem cadastro)</a>
      <div><button type="button" class="btn secondary" id="convert-another-btn">Converter outro PSD</button></div>
      <div class="cross-sell" id="extension-offer">
        <p class="cross-sell-label">Trabalha com imagens de sites?</p>
        <p class="dz-sub">Mantenha o Picture Converter no Chrome para capturar e converter imagens direto das páginas, sem abrir um conversor separado.</p>
        <div class="cross-sell-cards">
          <a class="cross-sell-card" id="picture-converter-store" href={pictureStore}>Adicionar Picture Converter ao Chrome</a>
        </div>
      </div>
    </div>

    <div class="dz-state" data-state-view="error" hidden>
      <p class="error-message" id="error-message">Não foi possível converter esse PSD. Tente novamente.</p>
      <button type="button" class="btn" id="retry-btn">Tentar novamente</button>
    </div>

    <input type="file" id="file-input" accept=".psd" hidden />
    <div class="sr-only" aria-live="polite" id="widget-status"></div>
  </div>

  <a class="trust-badge" href="#faq-client-side">100% no seu dispositivo — nada é enviado</a>
</section>

<script>
  import { track } from '../lib/analytics';
  import { takeHandoff } from '../lib/handoff';
  import { logPrivacyEvent, logRejection } from '../lib/privacyLog';

  const MAX_PSD_BYTES = 60 * 1024 * 1024;
  const widget = document.getElementById('converter-widget')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const chooseBtn = document.getElementById('choose-file-btn')!;
  const retryBtn = document.getElementById('retry-btn')!;
  const convertAnotherBtn = document.getElementById('convert-another-btn')!;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;
  const errorMessage = document.getElementById('error-message')!;
  const layerList = document.getElementById('layer-preview-list')!;
  const statusEl = document.getElementById('widget-status')!;
  const storeLink = document.getElementById('picture-converter-store') as HTMLAnchorElement | null;

  let currentObjectUrl: string | null = null;
  let dragCounter = 0;

  track('tool_view', {}, { interactive: false });

  function announce(state: string) {
    if (state === 'processing') statusEl.textContent = 'Convertendo…';
    else if (state === 'success') statusEl.textContent = 'Pronto. Seu JPG já pode ser baixado.';
    else if (state === 'error') statusEl.textContent = errorMessage.textContent ?? '';
    else statusEl.textContent = '';
  }

  function setState(state: 'empty' | 'drag-over' | 'processing' | 'success' | 'error') {
    widget.dataset.state = state;
    for (const el of widget.querySelectorAll<HTMLElement>('[data-state-view]')) el.hidden = el.dataset.stateView !== state;
    announce(state);
    if (state === 'processing') logPrivacyEvent('converting on this device');
    else if (state === 'success') logPrivacyEvent('done. nothing uploaded');
  }

  function sizeBucket(bytes: number): string {
    const mb = bytes / (1024 * 1024);
    if (mb < 1) return '<1mb';
    if (mb < 5) return '1-5mb';
    if (mb < 20) return '5-20mb';
    return '>20mb';
  }

  function durationBucket(ms: number): string {
    if (ms < 1000) return '<1s';
    if (ms < 3000) return '1-3s';
    if (ms < 10000) return '3-10s';
    return '>10s';
  }

  function layerBucket(n: number): string {
    if (n <= 1) return '1';
    if (n <= 5) return '2-5';
    if (n <= 20) return '6-20';
    return '>20';
  }

  function showError(reason: string, message: string) {
    errorMessage.textContent = message;
    setState('error');
    logRejection(reason);
    track('convert_error', { reason });
  }

  function revokeCurrentUrl() {
    if (currentObjectUrl) {
      URL.revokeObjectURL(currentObjectUrl);
      currentObjectUrl = null;
    }
  }

  function resetToEmpty() {
    revokeCurrentUrl();
    fileInput.value = '';
    setState('empty');
  }

  async function looksLikePsd(file: File): Promise<boolean> {
    try {
      const bytes = new Uint8Array(await file.slice(0, 4).arrayBuffer());
      return bytes[0] === 0x38 && bytes[1] === 0x42 && bytes[2] === 0x50 && bytes[3] === 0x53;
    } catch { return false; }
  }

  async function handleFile(file: File) {
    if (widget.dataset.state === 'processing') return;
    logPrivacyEvent('file selected locally');
    track('upload_start', { file_type: 'psd', size_bucket: sizeBucket(file.size) });

    if (!(await looksLikePsd(file))) {
      showError('unsupported_format', 'Este arquivo não parece ser um PSD válido. Escolha um arquivo .psd.');
      return;
    }
    if (file.size > MAX_PSD_BYTES) {
      showError('too_large', 'Este PSD tem mais de 60 MB. Escolha um arquivo menor.');
      return;
    }

    setState('processing');
    let buffer: ArrayBuffer;
    try { buffer = await file.arrayBuffer(); }
    catch {
      showError('corrupt', 'Não foi possível ler este arquivo.');
      return;
    }

    const worker = new Worker(new URL('../lib/converter/psdToImage.worker.ts', import.meta.url), { type: 'module' });
    worker.onmessage = (event: MessageEvent) => {
      const msg = event.data;
      if (msg.type === 'success') {
        const blob = new Blob([msg.buffer], { type: msg.mime });
        revokeCurrentUrl();
        currentObjectUrl = URL.createObjectURL(blob);
        downloadLink.href = currentObjectUrl;
        downloadLink.download = file.name.replace(/\.[^.]+$/, '') + '.jpg';
        layerList.innerHTML = '';
        const li = document.createElement('li');
        li.textContent = `🖼️ ${file.name.replace(/\.[^.]+$/, '')}.jpg (${msg.width}×${msg.height})`;
        layerList.appendChild(li);
        setState('success');
        track('convert_success', { duration_bucket: durationBucket(msg.durationMs), layer_bucket: layerBucket(msg.layerCount) });
      } else {
        showError(msg.reason || 'unknown', msg.message || 'A conversão falhou. Tente novamente.');
      }
      worker.terminate();
    };
    worker.onerror = () => {
      showError('unknown', 'A conversão falhou inesperadamente. Tente novamente.');
      worker.terminate();
    };
    worker.postMessage({ type: 'convert', buffer, output: 'jpg', fileName: file.name }, [buffer]);
  }

  chooseBtn.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (file) handleFile(file);
  });
  widget.addEventListener('click', (event) => {
    if (widget.dataset.state === 'empty' && !(event.target as HTMLElement).closest('button, a')) fileInput.click();
  });
  widget.addEventListener('dragenter', (event) => {
    event.preventDefault(); dragCounter++;
    if (widget.dataset.state === 'empty') setState('drag-over');
  });
  widget.addEventListener('dragover', (event) => event.preventDefault());
  widget.addEventListener('dragleave', (event) => {
    event.preventDefault(); dragCounter--;
    if (dragCounter <= 0 && widget.dataset.state === 'drag-over') setState('empty');
  });
  widget.addEventListener('drop', (event) => {
    event.preventDefault(); dragCounter = 0; fileInput.value = '';
    const file = event.dataTransfer?.files?.[0];
    if (file) handleFile(file);
    else if (widget.dataset.state === 'drag-over') setState('empty');
  });

  retryBtn.addEventListener('click', () => { track('retry_click'); resetToEmpty(); });
  convertAnotherBtn.addEventListener('click', () => { track('convert_another_clicked', { surface: 'widget' }); resetToEmpty(); });
  downloadLink.addEventListener('click', () => track('download_click'));
  storeLink?.addEventListener('click', () => track('extension_store_click', { product: 'picture_converter', placement: 'psd_to_jpg_success_offer' }));

  takeHandoff(['psd']).then((file) => { if (file) handleFile(file); });
</script>
