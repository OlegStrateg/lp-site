---
interface Props {
  active: 'resize' | 'crop' | 'meme';
  locale?: 'en' | 'ru';
}

const { active, locale = 'en' } = Astro.props;
const prefix = locale === 'ru' ? '/ru' : '';
const copy = locale === 'ru'
  ? {
      aria: 'Инструменты редактирования изображения',
      label: 'Редактировать изображение',
      crop: 'Обрезка',
      resize: 'Размер',
      meme: 'Meme',
      state: 'Одно изображение · переключайте инструменты',
      stateAria: 'Текущее изображение сохраняется при переключении инструментов',
    }
  : {
      aria: 'Image editing tools',
      label: 'Edit image',
      crop: 'Crop',
      resize: 'Resize',
      meme: 'Meme',
      state: 'One image · switch tools',
      stateAria: 'Current image stays loaded while switching tools',
    };
const tools = locale === 'ru'
  ? [
      { id: 'crop', label: copy.crop, href: `${prefix}/tools/crop-image/` },
      { id: 'resize', label: copy.resize, href: `${prefix}/tools/resize-image/` },
    ] as const
  : [
      { id: 'crop', label: copy.crop, href: '/tools/crop-image/' },
      { id: 'resize', label: copy.resize, href: '/tools/resize-image/' },
      { id: 'meme', label: copy.meme, href: '/tools/meme-generator/' },
    ] as const;
---

<nav class="image-workspace-nav" aria-label={copy.aria}>
  <div class="image-workspace-nav-inner">
    <span class="image-workspace-nav-label">{copy.label}</span>
    <div class="image-workspace-tabs" role="list">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class:list={['image-workspace-tab', { 'is-active': active === tool.id }]}
          aria-current={active === tool.id ? 'page' : undefined}
          data-astro-prefetch
        >
          {tool.label}
        </a>
      ))}
    </div>
    <span class="image-workspace-state" aria-label={copy.stateAria}>{copy.state}</span>
  </div>
</nav>
