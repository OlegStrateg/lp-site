---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  CONVERT_HUB_LOCALES,
  convertHubPath,
  localeExtensionsPath,
  localeHomePath,
  type ConvertHubLocale,
} from '../data/convertHubLocales';

interface Props { locale: ConvertHubLocale }
const { locale } = Astro.props;
const c = locale.copy;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://layerporter.com';
const canonicalPath = convertHubPath(locale);
const preferredImage = `${site}/og/convert.png`;
const homePath = localeHomePath(locale);
const extensionsPath = localeExtensionsPath(locale);
const pictureConverterPath = locale.code === 'en' ? '/picture-converter/' : `/${locale.route}/picture-converter/`;
const pictureConverterStore = 'https://chromewebstore.google.com/detail/picture-converter/oegpbmdpckfdgodnkdnoggedamfflfcl?utm_source=layerporter&utm_medium=website&utm_campaign=convert_hub&utm_content=extension_block';

const alternates = [
  ...CONVERT_HUB_LOCALES.map((item) => ({ hreflang: item.hreflang, href: `${site}${convertHubPath(item)}` })),
  { hreflang: 'x-default', href: `${site}/convert/` },
];

const schemaItems = [
  ['JPG to PDF', 'jpg-to-pdf'], ['PDF to JPG', 'pdf-to-jpg'], ['WebP to JPG', 'webp-to-jpg'],
  ['Favicon Generator', 'favicon-generator'], ['PSD to PNG', 'psd-to-png'], ['PSD to JPG', 'psd-to-jpg'],
  ['PNG to PSD', 'png-to-psd'], ['JPG to PSD', 'jpg-to-psd'], ['Canva to Google Slides', 'canva-to-google-slides'],
];

const heroRoutes = [
  { from: 'JPG', to: 'PDF', slug: 'jpg-to-pdf', short: c.jpgPdfShort },
  { from: 'PDF', to: 'JPG', slug: 'pdf-to-jpg', short: c.pdfJpgShort },
  { from: 'WEBP', to: 'JPG', slug: 'webp-to-jpg', short: c.webpJpgShort },
  { from: 'IMG', to: 'ICO', slug: 'favicon-generator', short: c.faviconShort },
  { from: 'PSD', to: 'PNG', slug: 'psd-to-png', short: c.psdPngShort },
  { from: 'PSD', to: 'JPG', slug: 'psd-to-jpg', short: c.psdJpgShort },
  { from: 'PNG', to: 'PSD', slug: 'png-to-psd', short: c.pngPsdShort },
  { from: 'JPG', to: 'PSD', slug: 'jpg-to-psd', short: c.jpgPsdShort },
];

const faqItems = [
  [c.faq1q, c.faq1a],
  [c.faq2q, c.faq2a],
  [c.faq3q, c.faq3a],
  [c.faq4q, c.faq4a],
].filter(([q, a]) => Boolean(q && a));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site}${canonicalPath}#collection`,
  url: `${site}${canonicalPath}`,
  inLanguage: locale.lang,
  name: locale.schemaName,
  description: locale.description,
  primaryImageOfPage: { '@type': 'ImageObject', url: preferredImage, width: 1200, height: 630 },
  isPartOf: { '@type': 'WebSite', '@id': `${site}/#website`, name: 'LayerPorter', url: `${site}/` },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: schemaItems.length,
    itemListElement: schemaItems.map(([name, slug], index) => ({
      '@type': 'ListItem', position: index + 1, name, url: `${site}/convert/${slug}/`,
    })),
  },
  hasPart: {
    '@type': 'SoftwareApplication', name: 'Picture Converter', applicationCategory: 'BrowserApplication',
    operatingSystem: 'Chrome', url: `${site}${pictureConverterPath}`,
  },
};
---

<BaseLayout
  title={locale.title}
  description={locale.description}
  canonicalPath={canonicalPath}
  ogImage={preferredImage}
  lang={locale.lang}
  dir={locale.dir}
  homePath={homePath}
  extensionsPath={extensionsPath}
  learnPath={`${homePath}#learn`}
  headerLabels={locale.nav}
  footerLabels={locale.footer}
  alternates={alternates}
>
  <link slot="head" rel="stylesheet" href="/convert-hub.css" />
  <link slot="head" rel="stylesheet" href="/convert-hub-i18n.css" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <details slot="headerExtra" class="hub-lang-switch">
    <summary aria-label={c.language}>{locale.name}<span aria-hidden="true">⌄</span></summary>
    <div class="hub-lang-menu">
      {CONVERT_HUB_LOCALES.map((item) => (
        <a href={convertHubPath(item)} lang={item.lang} aria-current={item.code === locale.code ? 'page' : undefined}>{item.name}</a>
      ))}
    </div>
  </details>

  <div class="hub">
    <section class="hub-hero" aria-labelledby="convert-h1">
      <div class="hub-hero-copy">
        {c.heroEyebrow && <div class="hub-eyebrow"><span aria-hidden="true">↔</span> {c.heroEyebrow}</div>}
        <h1 id="convert-h1"><span>{c.heroA}</span>{c.heroB && <><br />{c.heroB}</>}</h1>
        {c.heroBody && <p>{c.heroBody}</p>}
        <div class="hub-proof" aria-label={c.proofAria}>
          {c.proofConverters && <span><b>●</b> {c.proofConverters}</span>}
          {c.proofChecker && <span><b>●</b> {c.proofChecker}</span>}
          {c.proofLocal && <span><b>●</b> {c.proofLocal}</span>}
        </div>
      </div>

      <div class="hub-route-board" aria-label={c.routeAria}>
        <div class="hub-route-head"><strong>{c.chooseConversion}</strong>{c.allCurrentTools && <span>{c.allCurrentTools}</span>}</div>
        <div class="hub-route-columns">
          {[heroRoutes.slice(0, 4), heroRoutes.slice(4)].map((column) => (
            <div class="hub-route-column">
              {column.map((item) => (
                <a class="hub-route" href={`/convert/${item.slug}/`}>
                  <span class="hub-code">{item.from}</span><i>→</i><span class="hub-code out">{item.to}</span>
                  <span class="hub-route-copy"><b>{item.from} → {item.to}</b>{item.short && <small>{item.short}</small>}</span><em>↗</em>
                </a>
              ))}
            </div>
          ))}
        </div>
        <div class="hub-route-foot"><strong>● {c.filesStay}</strong><a href="#checker">{c.checkerJump}</a></div>
      </div>
    </section>

    <section class="hub-section" id="popular" aria-labelledby="popular-heading">
      {c.popularLabel && <div class="hub-section-label">{c.popularLabel}</div>}
      <div class={`hub-section-head${c.popularIntro ? '' : ' is-single'}`}>
        <h2 id="popular-heading">{c.popularHeading}</h2>{c.popularIntro && <p>{c.popularIntro}</p>}
      </div>
      <div class="hub-popular-grid">
        <a class="hub-tool-card" href="/convert/jpg-to-pdf/">
          <picture class="hub-tool-image">
            <source srcset="/images/picture-converter/images-to-pdf-example-320.webp 320w, /images/picture-converter/images-to-pdf-example-640.webp 640w, /images/picture-converter/images-to-pdf-example-960.webp 960w" sizes="(max-width:760px) 100vw, 48vw" />
            <img src="/images/picture-converter/images-to-pdf-example-640.webp" width="640" height="427" alt={c.jpgPdfAlt} loading="lazy" />
          </picture>
          <div class="hub-tool-body"><div class="hub-pair"><span>JPG</span><i>→</i><span>PDF</span></div><h3>JPG → PDF</h3>{c.jpgPdfDesc && <p>{c.jpgPdfDesc}</p>}<b class="hub-open">{c.openConverter} <span>↗</span></b></div>
        </a>
        <a class="hub-tool-card" href="/convert/pdf-to-jpg/">
          <div class="hub-pdf-visual" aria-hidden="true"><div class="hub-pdf-sheet"><div></div><i></i><i class="medium"></i><i class="short"></i></div><span class="hub-big-arrow">→</span><div class="hub-jpg-stack"><i></i><i></i><i><b>JPG</b></i></div></div>
          <div class="hub-tool-body"><div class="hub-pair"><span>PDF</span><i>→</i><span>JPG</span></div><h3>PDF → JPG</h3>{c.pdfJpgDesc && <p>{c.pdfJpgDesc}</p>}<b class="hub-open">{c.openConverter} <span>↗</span></b></div>
        </a>
        <a class="hub-tool-card" href="/convert/webp-to-jpg/">
          <picture class="hub-tool-image">
            <source srcset="/images/picture-converter/webp-to-jpg-example-320.webp 320w, /images/picture-converter/webp-to-jpg-example-640.webp 640w, /images/picture-converter/webp-to-jpg-example-960.webp 960w" sizes="(max-width:760px) 100vw, 48vw" />
            <img src="/images/picture-converter/webp-to-jpg-example-640.webp" width="640" height="427" alt={c.webpJpgAlt} loading="lazy" />
          </picture>
          <div class="hub-tool-body"><div class="hub-pair"><span>WEBP</span><i>→</i><span>JPG</span></div><h3>WebP → JPG</h3>{c.webpJpgDesc && <p>{c.webpJpgDesc}</p>}<b class="hub-open">{c.openConverter} <span>↗</span></b></div>
        </a>
        <a class="hub-tool-card" href="/convert/favicon-generator/">
          <div class="hub-favicon-visual" aria-hidden="true"><div class="hub-favicon-main">LP</div><div class="hub-icon-sizes"><span><i></i><b>16</b></span><span><i></i><b>32</b></span><span><i></i><b>48</b></span><span><i></i><b>180</b></span><span><i></i><b>256</b></span><span><i></i><b>512</b></span></div></div>
          <div class="hub-tool-body"><div class="hub-pair"><span>IMG</span><i>→</i><span>ICO</span></div><h3>Favicon Generator</h3>{c.faviconDesc && <p>{c.faviconDesc}</p>}<b class="hub-open">{c.openTool} <span>↗</span></b></div>
        </a>
      </div>
    </section>

    <section class="hub-section hub-section-alt" id="design" aria-labelledby="design-heading">
      {c.designLabel && <div class="hub-section-label">{c.designLabel}</div>}
      <div class={`hub-section-head${c.designIntro ? '' : ' is-single'}`}><h2 id="design-heading">{c.designHeading}</h2>{c.designIntro && <p>{c.designIntro}</p>}</div>
      <div class="hub-design-grid">
        <a class="hub-design-card" href="/convert/psd-to-png/"><div><div class="hub-pair"><span>PSD</span><i>→</i><span>PNG</span></div><h3>PSD → PNG</h3>{c.psdPngDesc && <p>{c.psdPngDesc}</p>}<b>{c.openConverter} ↗</b></div><div class="hub-design-art"><div class="hub-art-flow"><span class="hub-layer-stack"><i></i><i></i><i></i></span><em>→</em><span class="hub-output png">PNG</span></div></div></a>
        <a class="hub-design-card" href="/convert/psd-to-jpg/"><div><div class="hub-pair"><span>PSD</span><i>→</i><span>JPG</span></div><h3>PSD → JPG</h3>{c.psdJpgDesc && <p>{c.psdJpgDesc}</p>}<b>{c.openConverter} ↗</b></div><div class="hub-design-art"><div class="hub-art-flow"><span class="hub-layer-stack"><i></i><i></i><i></i></span><em>→</em><span class="hub-output jpg">JPG</span></div></div></a>
        <a class="hub-design-card" href="/convert/png-to-psd/"><div><div class="hub-pair"><span>PNG</span><i>→</i><span>PSD</span></div><h3>PNG → PSD</h3>{c.pngPsdDesc && <p>{c.pngPsdDesc}</p>}<b>{c.openConverter} ↗</b></div><div class="hub-design-art"><div class="hub-art-flow"><span class="hub-output png">PNG</span><em>→</em><span class="hub-output psd">PSD</span></div></div></a>
        <a class="hub-design-card" href="/convert/jpg-to-psd/"><div><div class="hub-pair"><span>JPG</span><i>→</i><span>PSD</span></div><h3>JPG → PSD</h3>{c.jpgPsdDesc && <p>{c.jpgPsdDesc}</p>}<b>{c.openConverter} ↗</b></div><div class="hub-design-art"><div class="hub-art-flow"><span class="hub-output jpg">JPG</span><em>→</em><span class="hub-output psd">PSD</span></div></div></a>
      </div>

      <a class="hub-checker hub-checker-simple" id="checker" href="/convert/canva-to-google-slides/">
        <div class="hub-checker-copy"><span>{c.compatibilityChecker}</span><h3>Canva → Google Slides</h3>{c.checkerDesc && <p>{c.checkerDesc}</p>}<b>{c.openChecker} <i>↗</i></b></div>
        <div class="hub-checker-simple-visual" aria-hidden="true">
          <div class="hub-checker-flow"><span>CANVA</span><i>→</i><span>PPTX</span><i>→</i><span>SLIDES</span></div>
          <div class="hub-checker-chips"><span>Aa</span><span>▣</span><span>✦</span></div>
        </div>
      </a>
    </section>

    <section class="hub-extension" id="picture-converter" aria-labelledby="picture-converter-heading">
      <div class="hub-extension-visual"><img src="/images/picture-converter/picture-converter-chrome-960.webp" srcset="/images/picture-converter/picture-converter-chrome-320.webp 320w, /images/picture-converter/picture-converter-chrome-640.webp 640w, /images/picture-converter/picture-converter-chrome-960.webp 960w" sizes="(max-width:800px) 100vw, 58vw" width="960" height="640" alt={c.pictureAlt} loading="lazy" /></div>
      <div class="hub-extension-copy"><div class="hub-extension-brand"><img src="/picture-converter/welcome/picture-converter-icon.png" width="46" height="46" alt={c.pictureIconAlt} loading="lazy" /><div><strong>Picture Converter</strong><small>{c.chromeExtension}</small></div></div><h2 id="picture-converter-heading">{c.extensionHeading}</h2>{c.extensionBody && <p>{c.extensionBody}</p>}<div class="hub-extension-actions"><a class="store" href={pictureConverterStore}>{c.addChrome}</a><a class="details" href={pictureConverterPath}>{c.seePicture}</a></div></div>
    </section>

    <section class="hub-section hub-faq" aria-labelledby="faq-heading">
      <div>{c.faqLabel && <div class="hub-section-label">{c.faqLabel}</div>}<h2 id="faq-heading">{c.faqHeading}</h2></div>
      <div class="hub-faq-list">
        {faqItems.map(([q, a], index) => (
          <details><summary><span>{String(index + 1).padStart(2, '0')}</span>{q}<i>+</i></summary><p>{a}</p></details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
