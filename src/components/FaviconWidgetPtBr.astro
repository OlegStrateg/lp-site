---
import Icon from './Icon.astro';

interface Props { toolHeading: string }
const { toolHeading } = Astro.props;
const pictureStore = 'https://chromewebstore.google.com/detail/picture-converter/oegpbmdpckfdgodnkdnoggedamfflfcl?utm_source=layerporter&utm_medium=website&utm_campaign=ptbr_favicon_generator&utm_content=success_offer';
---

<section aria-labelledby="tool-heading" class="tool-section">
  <h2 id="tool-heading" class="tool-heading">{toolHeading}</h2>

  <div id="favicon-widget" class="converter-widget" data-state="empty" role="group" aria-label="Gerador de favicon a partir de PNG ou JPG">
    <div class="dz-state" data-state-view="empty">
      <div class="dz-empty-icon"><Icon name="folder" /></div>
      <p class="dz-title">Solte um PNG ou JPG — ou clique para escolher</p>
      <p class="dz-sub">A imagem não sai desta aba.</p>
      <button type="button" class="btn" id="choose-file-btn">Escolher imagem — grátis</button>
    </div>

    <div class="dz-state" data-state-view="drag-over" hidden><p class="dz-title">Solte para gerar os favicons</p></div>

    <div class="dz-state" data-state-view="processing" hidden>
      <div class="progress-track" aria-hidden="true"><div class="progress-fill"></div></div>
      <p class="dz-title">Gerando seu conjunto de favicons…</p>
    </div>

    <div class="dz-state" data-state-view="success" hidden>
      <p class="dz-title">Seu conjunto de favicons está pronto</p>
      <ul class="favicon-preview" id="favicon-preview"></ul>
      <a class="btn" id="download-link" download>Baixar ZIP (sem cadastro)</a>
      <div class="favicon-tags">
        <p class="dz-sub">Use estas tags no &lt;head&gt; do seu site. Os nomes correspondem aos arquivos do ZIP:</p>
        <pre class="favicon-tags-code" id="favicon-tags-code">{`<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">`}</pre>
        <button type="button" class="btn secondary" id="copy-tags-btn">Copiar tags</button>
      </div>
      <div><button type="button" class="btn secondary" id="convert-another-btn">Gerar outro</button></div>
      <div class="cross-sell" id="extension-offer">
        <p class="cross-sell-label">Quer converter imagem → ICO direto no Chrome?</p>
        <p class="dz-sub">O Picture Converter converte uma imagem selecionada em um site ou um arquivo local para ICO, além de JPG, PNG, WebP e PDF.</p>
        <div class="cross-sell-cards">
          <a class="cross-sell-card" id="picture-converter-store" href={pictureStore}>Adicionar Picture Converter ao Chrome</a>
        </div>
      </div>
    </div>

    <div class="dz-state" data-state-view="error" hidden>
      <p class="error-message" id="error-message">Não foi possível gerar os favicons. Tente novamente.</p>
      <button type="button" class="btn" id="retry-btn">Tentar novamente</button>
    </div>

    <input type="file" id="file-input" accept="image/png,image/jpeg" hidden />
    <div class="sr-only" aria-live="polite" id="widget-status"></div>
  </div>

  <a class="trust-badge" href="#faq-client-side">100% no seu dispositivo — nada é enviado</a>
</section>

<script>
  import { track } from '../lib/analytics';
  import { takeHandoff } from '../lib/handoff';
  import { logPrivacyEvent, logRejection } from '../lib/privacyLog';

  const MAX_BYTES = 30 * 1024 * 1024;
  const MAX_DIMENSION = 6000;

  const widget = document.getElementById('favicon-widget')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const chooseBtn = document.getElementById('choose-file-btn')!;
  const retryBtn = document.getElementById('retry-btn')!;
  const convertAnotherBtn = document.getElementById('convert-another-btn')!;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;
  const errorMessage = document.getElementById('error-message')!;
  const previewList = document.getElementById('favicon-preview')!;
  const tagsCode = document.getElementById('favicon-tags-code')!;
  const copyTagsBtn = document.getElementById('copy-tags-btn')!;
  const statusEl = document.getElementById('widget-status')!;
  const storeLink = document.getElementById('picture-converter-store') as HTMLAnchorElement | null;

  const objectUrls: string[] = [];
  let dragCounter = 0;

  track('tool_view', {}, { interactive: false });

  type State = 'empty' | 'drag-over' | 'processing' | 'success' | 'error';

  function announce(state: State) {
    if (state === 'processing') statusEl.textContent = 'Gerando…';
    else if (state === 'success') statusEl.textContent = 'Pronto. Seu conjunto de favicons pode ser baixado.';
    else if (state === 'error') statusEl.textContent = errorMessage.textContent ?? '';
    else statusEl.textContent = '';
  }

  function setState(state: State) {
    widget.dataset.state = state;
    for (const el of widget.querySelectorAll<HTMLElement>('[data-state-view]')) el.hidden = el.dataset.stateView !== state;
    announce(state);
    if (state === 'processing') logPrivacyEvent('converting on this device');
    else if (state === 'success') logPrivacyEvent('done. nothing uploaded');
  }

  function sizeBucket(bytes: number): string {
    const mb = bytes / (1024 * 1024);
    if (mb < 1) return '<1mb';
    if (mb < 5) return '1-5mb';
    if (mb < 20) return '5-20mb';
    return '>20mb';
  }

  function durationBucket(ms: number): string {
    if (ms < 1000) return '<1s';
    if (ms < 3000) return '1-3s';
    if (ms < 10000) return '3-10s';
    return '>10s';
  }

  function showError(reason: string, message: string) {
    errorMessage.textContent = message;
    setState('error');
    logRejection(reason);
    track('convert_error', { reason });
  }

  function revokeAllUrls() {
    for (const url of objectUrls) URL.revokeObjectURL(url);
    objectUrls.length = 0;
  }

  function resetToEmpty() {
    revokeAllUrls();
    fileInput.value = '';
    setState('empty');
  }

  async function resolveMimeType(file: File): Promise<string> {
    if (file.type) return file.type;
    try {
      const bytes = new Uint8Array(await file.slice(0, 4).arrayBuffer());
      if (bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47) return 'image/png';
      if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg';
    } catch { /* fall through */ }
    return '';
  }

  async function handleFile(file: File) {
    if (widget.dataset.state === 'processing') return;
    logPrivacyEvent('file selected locally');
    track('upload_start', { file_type: 'image', size_bucket: sizeBucket(file.size) });

    const mimeType = await resolveMimeType(file);
    if (!['image/png', 'image/jpeg'].includes(mimeType)) {
      showError('unsupported_format', 'Este tipo de arquivo não é compatível. Escolha uma imagem PNG ou JPG.');
      return;
    }
    if (file.size > MAX_BYTES) {
      showError('too_large', 'Esta imagem tem mais de 30 MB. Escolha um arquivo menor.');
      return;
    }

    setState('processing');
    let bitmap: ImageBitmap;
    try { bitmap = await createImageBitmap(file); }
    catch {
      showError('corrupt', 'Não foi possível ler a imagem. Ela pode estar corrompida ou em um formato não compatível.');
      return;
    }

    if (bitmap.width > MAX_DIMENSION || bitmap.height > MAX_DIMENSION) {
      bitmap.close();
      showError('too_large_dimensions', `A imagem é maior que ${MAX_DIMENSION}×${MAX_DIMENSION}px. Escolha uma imagem menor.`);
      return;
    }

    const worker = new Worker(new URL('../lib/ico/favicon.worker.ts', import.meta.url), { type: 'module' });
    worker.onmessage = (event: MessageEvent) => {
      const msg = event.data;
      if (msg.type === 'success') {
        revokeAllUrls();
        const zipUrl = URL.createObjectURL(new Blob([msg.zipBuffer], { type: 'application/zip' }));
        objectUrls.push(zipUrl);
        downloadLink.href = zipUrl;
        downloadLink.download = 'favicons.zip';

        previewList.innerHTML = '';
        for (const { size, buffer } of msg.previews as { size: number; buffer: ArrayBuffer }[]) {
          const url = URL.createObjectURL(new Blob([buffer], { type: 'image/png' }));
          objectUrls.push(url);
          const li = document.createElement('li');
          const img = document.createElement('img');
          img.src = url;
          img.alt = `Prévia do favicon ${size}×${size}`;
          img.width = Math.min(size, 64);
          img.height = Math.min(size, 64);
          const label = document.createElement('span');
          label.textContent = `${size}×${size}`;
          li.append(img, label);
          previewList.appendChild(li);
        }

        setState('success');
        track('convert_success', { duration_bucket: durationBucket(msg.durationMs) });
      } else {
        showError(msg.reason || 'unknown', msg.message || 'A geração falhou. Tente novamente.');
      }
      worker.terminate();
    };
    worker.onerror = () => {
      showError('unknown', 'A geração falhou inesperadamente. Tente novamente.');
      worker.terminate();
    };
    worker.postMessage({ type: 'convert', bitmap }, [bitmap]);
  }

  chooseBtn.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (file) handleFile(file);
  });
  widget.addEventListener('click', (event) => {
    if (widget.dataset.state === 'empty' && !(event.target as HTMLElement).closest('button, a')) fileInput.click();
  });
  widget.addEventListener('dragenter', (event) => {
    event.preventDefault(); dragCounter++;
    if (widget.dataset.state === 'empty') setState('drag-over');
  });
  widget.addEventListener('dragover', (event) => event.preventDefault());
  widget.addEventListener('dragleave', (event) => {
    event.preventDefault(); dragCounter--;
    if (dragCounter <= 0 && widget.dataset.state === 'drag-over') setState('empty');
  });
  widget.addEventListener('drop', (event) => {
    event.preventDefault(); dragCounter = 0;
    const file = event.dataTransfer?.files?.[0];
    if (file) handleFile(file);
    else if (widget.dataset.state === 'drag-over') setState('empty');
  });

  retryBtn.addEventListener('click', () => { track('retry_click'); resetToEmpty(); });
  convertAnotherBtn.addEventListener('click', () => { track('convert_another_clicked', { surface: 'widget' }); resetToEmpty(); });
  downloadLink.addEventListener('click', () => track('download_click'));
  storeLink?.addEventListener('click', () => track('extension_store_click', { product: 'picture_converter', placement: 'favicon_success_offer' }));

  copyTagsBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(tagsCode.textContent ?? '');
      const original = copyTagsBtn.textContent;
      copyTagsBtn.textContent = 'Copiado!';
      track('copy_tags_click');
      setTimeout(() => { copyTagsBtn.textContent = original; }, 1500);
    } catch { /* o bloco continua selecionável manualmente */ }
  });

  takeHandoff(['png', 'jpg']).then((file) => { if (file) handleFile(file); });
</script>
